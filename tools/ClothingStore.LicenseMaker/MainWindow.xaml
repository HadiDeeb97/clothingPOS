<Window x:Class="ClothingStore.LicenseMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClothingStore.LicenseMaker"
        Title="License Maker · Clothing Store POS" Width="1180" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}" FontFamily="Segoe UI" FontSize="13">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <DockPanel Margin="18">
        <!-- Keys folder -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy public key for the app" Command="{Binding CopyPublicKeyCommand}"
                            Visibility="{Binding HasKeys, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Open my keys folder…" Command="{Binding OpenKeysFolderCommand}" />
                    <Button Content="Create new keys…" Command="{Binding CreateKeysCommand}" Margin="0"
                            Visibility="{Binding NeedsKeys, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="Your keys folder" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                        <Run Text="{Binding KeysFolder, Mode=OneWay, TargetNullValue='Not chosen yet'}" />
                        <Run Text=" — holds private.pem and the customer list. Back it up; never send it to anyone." />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{StaticResource Primary}" FontWeight="SemiBold" Margin="2,10,0,0" TextWrapping="Wrap" />

        <!-- First run -->
        <Border Style="{StaticResource Card}" Visibility="{Binding NeedsKeys, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" Padding="24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Set up once" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0">
                    Licenses are signed with your own secret key, so only you can make them.
                </TextBlock>
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="22">
                    <Bold>First time:</Bold> click <Bold>Create new keys…</Bold> and choose a folder (for example Documents\POS Licenses).
                    Then click <Bold>Copy public key for the app</Bold>, paste it into <Italic>licensing.json</Italic> and build the app you sell.
                    <LineBreak />
                    <Bold>Already have keys</Bold> (made with pos-license keygen)? Click <Bold>Open my keys folder…</Bold> and pick the folder with private.pem.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Main -->
        <Grid Visibility="{Binding HasKeys, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- Customers -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Add old keys…" Command="{Binding ImportKeyCommand}" Margin="0"
                                ToolTip="Add .lic files made earlier with the command-line tool to this list" />
                        <StackPanel>
                            <TextBlock Text="Customers" Style="{StaticResource Title}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                             ToolTip="Search by store, phone or PC ID" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Copy key" Command="{Binding CopySelectedKeyCommand}" />
                        <Button Content="Save .lic file…" Command="{Binding SaveSelectedKeyCommand}" />
                        <TextBlock Text="Select a store to renew it on the right." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Border}"
                              BorderThickness="0" Background="White" RowHeight="32" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Urgency}" Value="1">
                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Urgency}" Value="2">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Store" Binding="{Binding Store}" Width="*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                            <DataGridTextColumn Header="PCs" Binding="{Binding Pcs}" Width="50" />
                            <DataGridTextColumn Header="Last day" Binding="{Binding Expires}" Width="110" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- New / renew -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+ New customer" Command="{Binding NewCommand}" Margin="0" Padding="10,4" />
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Title}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>

                        <TextBlock Text="Store name" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Licensee, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Phone (for your records)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

                        <DockPanel Margin="0,12,0,4">
                            <Button DockPanel.Dock="Right" Content="Paste" Command="{Binding PasteMachineIdCommand}" Margin="0" Padding="10,2"
                                    ToolTip="Add the PC ID the customer sent you (copied to the clipboard)" />
                            <TextBlock Text="PC IDs (one per line)" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                        </DockPanel>
                        <TextBox Text="{Binding MachineText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="76"
                                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource Hint}" Text="Shown on the customer's activation screen, e.g. 7KQ2-M9XD-ABCD-EFGH. Several tills can share one license." />

                        <TextBlock Text="How long" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding SelectedDuration}" DisplayMemberPath="Label" Padding="6,5" />
                        <DatePicker SelectedDate="{Binding CustomDate}" Margin="0,6,0,0"
                                    Visibility="{Binding IsCustomDate, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding PeriodHint}" Style="{StaticResource Hint}" />

                        <TextBlock Text="Notes (optional, inside the key)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Generate key" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}"
                                HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="14,10" FontSize="14" />

                        <!-- Result -->
                        <Border Visibility="{Binding HasGeneratedKey, Converter={StaticResource BoolToVis}}" Background="#ECFDF5"
                                BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding GeneratedSummary}" FontWeight="SemiBold" Foreground="{StaticResource Success}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding GeneratedKey, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="70" Margin="0,8,0,8"
                                         FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" />
                                <WrapPanel>
                                    <Button Content="Copy key" Command="{Binding CopyKeyCommand}" Margin="0,0,8,6" />
                                    <Button Content="Copy WhatsApp message" Command="{Binding CopyMessageCommand}" Margin="0,0,8,6" />
                                    <Button Content="Save .lic file…" Command="{Binding SaveKeyCommand}" Margin="0,0,0,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
