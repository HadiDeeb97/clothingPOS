<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ClothingStore.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClothingStore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Translations: {area}.{language}.json, see Localization/Loc.cs. WithCulture=false keeps MSBuild from
         treating ".en"/".ar" as satellite-assembly cultures. -->
    <EmbeddedResource Include="Localization\Strings\*.json" LogicalName="Strings.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
