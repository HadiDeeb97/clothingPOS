<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.ExchangeRateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="520">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{l:T Rate.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True"
                    IsEnabled="{Binding CanChange}" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="{l:T Rate.Current}" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding CurrentRateText}" FontSize="18" FontWeight="SemiBold" />

            <TextBlock Text="{l:T Rate.New}" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
            <TextBox x:Name="RateBox" Style="{StaticResource BigNumberBox}" Tag="{l:T Currency.Lbp}"
                     Text="{Binding NewRateText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding Preview}" Style="{StaticResource HintText}" Foreground="{StaticResource PrimaryDarkBrush}" />
            <TextBlock Text="{l:T Rate.Hint}" Style="{StaticResource HintText}" />

            <TextBlock Text="{l:T Rate.History}" Style="{StaticResource Caption}" Margin="0,20,0,6" />
            <Border Style="{StaticResource TableCard}" MaxHeight="220">
                <DataGrid ItemsSource="{Binding History}" IsReadOnly="True" HeadersVisibility="Column" MinHeight="80">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Rate.When}" Binding="{Binding ChangedAt, StringFormat=g}" Width="140" />
                        <DataGridTextColumn Header="{l:T Rate.From}" Binding="{Binding OldRate, StringFormat=N0}" Width="90" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="{l:T Rate.To}" Binding="{Binding NewRate, StringFormat=N0}" Width="90" ElementStyle="{StaticResource StrongRightCell}" />
                        <DataGridTextColumn Header="{l:T Rate.By}" Binding="{Binding User.FullName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
