<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.OnlineOrderEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="1000" Height="640">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}" Margin="0,14,0,0">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{l:T Orders.SaveOrder}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="8,0,0,0" MinWidth="120" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Who and where -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="{l:T Orders.Channel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <DockPanel Margin="0,12,0,5">
                        <Button DockPanel.Dock="Right" Content="{l:T Orders.PickCustomer}" Style="{StaticResource LinkButton}" Command="{Binding PickCustomerCommand}" Margin="0" />
                        <TextBlock Text="{l:T Common.Name}" Style="{StaticResource FieldLabel}" Margin="0" />
                    </DockPanel>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Content="{l:T Common.Remove}" Style="{StaticResource LinkButton}" Command="{Binding ClearCustomerCommand}" Margin="0" />
                        <TextBlock Text="{l:T Orders.LinkedCustomer}" Style="{StaticResource HintText}" Margin="0" Foreground="{StaticResource SuccessBrush}" />
                    </DockPanel>

                    <TextBlock Text="{l:T Common.Phone}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{l:T Orders.Handle}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Handle, UpdateSourceTrigger=PropertyChanged}" Tag="@" />
                    <TextBlock Text="{l:T Orders.Address}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineBox}" />
                    <TextBlock Text="{l:T Common.Notes}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineBox}" />
                    <CheckBox Content="{l:T Orders.SaveCustomer}" IsChecked="{Binding SaveCustomer}" Margin="0,12,0,0"
                              Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </ScrollViewer>

            <!-- What -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddBox" Style="{StaticResource SearchBox}" Tag="{l:T Labels.AddHint}"
                             Text="{Binding AddText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="{l:T Labels.Add}" Command="{Binding FindCommand}" Margin="8,0,0,0" />
                </Grid>

                <!-- Several matches: pick one -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0" MaxHeight="200"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding Results}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2">
                                    <Button DockPanel.Dock="Right" Content="{l:T Labels.Add}" Margin="8,0,0,0" Padding="10,3"
                                            Command="{Binding DataContext.AddResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding EffectivePrice, Converter={StaticResource Money}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StockQuantity, StringFormat={l:T Orders.InStock}}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Totals -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T Orders.DeliveryFee}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding DeliveryFeeText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Tag="$" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                       Text="{Binding ItemsTotal, Converter={StaticResource Money}, StringFormat={l:T Orders.ItemsFormat}}" />
                            <TextBlock Text="{Binding Total, Converter={StaticResource Money}}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding TotalLbp, Converter={StaticResource Lbp}}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Visibility="{Binding ShowLbp, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource TableCard}" Margin="0,10,0,0">
                    <Grid>
                        <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Lines}" IsReadOnly="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T Common.Item}" Binding="{Binding Name, Mode=OneWay}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="{l:T Labels.Variant}" Binding="{Binding Variant.Description, Mode=OneWay}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="{l:T Common.Price}" Binding="{Binding Variant.EffectivePrice, Converter={StaticResource Money}, Mode=OneWay}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTemplateColumn Header="{l:T Common.Stock}" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="Stock" Text="{Binding Variant.StockQuantity}" HorizontalAlignment="Right" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsShort}" Value="True">
                                                    <Setter TargetName="Stock" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter TargetName="Stock" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Common.Qty}" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" MinHeight="28" HorizontalContentAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T Common.Total}" Binding="{Binding LineTotal, Converter={StaticResource Money}, Mode=OneWay}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource StrongRightCell}" />
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" ToolTip="{l:T Common.Remove}"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{l:T Orders.NoItems}" Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasLines, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
