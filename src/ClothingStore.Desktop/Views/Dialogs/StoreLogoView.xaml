<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.StoreLogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="480">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{l:T Common.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <DockPanel>
                <!-- How it looks on a window title bar / taskbar, and large -->
                <Border Width="140" Height="140" CornerRadius="16" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Margin="0,0,18,0">
                    <Grid>
                        <Image Source="{Binding Preview}" Stretch="Uniform" Margin="12" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{l:T Logo.None}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T Logo.Heading}" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource SidebarBrush}" Margin="0,0,8,0">
                            <Image Source="{Binding Preview}" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Border Width="20" Height="20" Background="{StaticResource HoverBrush}" VerticalAlignment="Center">
                            <Image Source="{Binding Preview}" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:T Logo.Choose}" Style="{StaticResource PrimaryButton}" Command="{Binding ChooseCommand}" />
                        <Button Content="{l:T Common.Remove}" Command="{Binding RemoveCommand}" IsEnabled="{Binding HasPreview}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{l:T Logo.Hint}" Style="{StaticResource HintText}" Margin="0,16,0,0" />
        </StackPanel>
    </DockPanel>
</UserControl>
