<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.UserEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380">
    <StackPanel>
        <TextBlock Text="Username *" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
        <TextBox x:Name="UserBox" Text="{Binding Username}" />
        <TextBlock Text="Full name *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding FullName}" />
        <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" />
        <TextBlock Text="Password (leave blank to keep current)" Style="{StaticResource FieldLabel}"
                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
        <TextBlock Text="Password *" Style="{StaticResource FieldLabel}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />
        <CheckBox Content="Must change password at next sign-in" IsChecked="{Binding MustChangePassword}" Margin="0,10,0,0" />
        <CheckBox Content="Active" IsChecked="{Binding IsActive}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</UserControl>
