<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.UserEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="400">
    <StackPanel>
        <TextBlock Text="{l:T Users.UsernameRequired}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
        <TextBox x:Name="UserBox" Text="{Binding Username}" />
        <TextBlock Text="{l:T Users.FullNameRequired}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding FullName}" />
        <TextBlock Text="{l:T Common.Role}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{l:T Users.PasswordKeep}" Style="{StaticResource FieldLabel}"
                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
        <TextBlock Text="{l:T Users.PasswordRequired}" Style="{StaticResource FieldLabel}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />
        <CheckBox Content="{l:T Users.MustChange}" IsChecked="{Binding MustChangePassword}" Margin="0,14,0,0" />
        <CheckBox Content="{l:T Common.Active}" IsChecked="{Binding IsActive}" />
        <StackPanel Style="{StaticResource DialogFooter}">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{l:T Common.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</UserControl>
