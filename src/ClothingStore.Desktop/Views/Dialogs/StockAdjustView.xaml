<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.StockAdjustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="440">
    <StackPanel>
        <TextBlock Text="{Binding Item.DisplayName}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Item.Sku}" Style="{StaticResource MutedText}" Margin="0,0,12,0" />
            <Border Style="{StaticResource Chip}">
                <TextBlock Text="{Binding Item.StockQuantity, StringFormat={l:T Inventory.OnHandFormat}}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </StackPanel>
        <TextBlock Text="{l:T Common.Reason}" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
        <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding SelectedReason}" DisplayMemberPath="Label" />
        <TextBlock Text="{l:T Common.Qty}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
        <TextBlock Text="{l:T Common.Notes}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Style="{StaticResource DialogFooter}">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{l:T Inventory.SaveAdjustment}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</UserControl>
