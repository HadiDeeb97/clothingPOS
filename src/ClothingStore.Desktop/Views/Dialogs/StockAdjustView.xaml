<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.StockAdjustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">
    <StackPanel>
        <TextBlock Text="{Binding Item.DisplayName}" Style="{StaticResource SectionTitle}" Margin="0" />
        <TextBlock Style="{StaticResource MutedText}">
            <Run Text="{Binding Item.Sku, Mode=OneWay}" /> · on hand: <Run Text="{Binding Item.StockQuantity, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>
        <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
        <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding SelectedReason}" DisplayMemberPath="Label" />
        <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Notes}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="Save adjustment" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</UserControl>
