<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.PurchaseOrderEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1100" Height="640">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Supplier *" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Expected delivery" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <DatePicker SelectedDate="{Binding ExpectedDate}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <TextBox Text="{Binding Notes}" />
            </StackPanel>
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="Save order" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold">
                <Run Text="{Binding TotalUnits, Mode=OneWay}" /> units ·
                <Run Text="{Binding Total, Converter={StaticResource Money}, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Add items" Style="{StaticResource SectionTitle}" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Product, SKU, barcode…">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add selected" Command="{Binding AddResultCommand}" CommandParameter="{x:Null}" />
                    <Button Content="Add all results" Command="{Binding AddAllResultsCommand}" />
                    <Button Content="Add supplier's low stock" Command="{Binding AddLowStockCommand}" Margin="0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}" MouseDoubleClick="OnResultDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ITEM" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="STOCK" Binding="{Binding StockQuantity}" Width="55" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="COST" Binding="{Binding EffectiveCost, Converter={StaticResource Money}}" Width="70" ElementStyle="{StaticResource RightCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Order lines" Style="{StaticResource SectionTitle}" />
                <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ITEM" Binding="{Binding Variant.DisplayName, Mode=OneWay}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Variant.Sku, Mode=OneWay}" Width="130" IsReadOnly="True" />
                        <DataGridTextColumn Header="ON HAND" Binding="{Binding Variant.StockQuantity, Mode=OneWay}" Width="70" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="QTY" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="4,1" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="UNIT COST" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UnitCost, UpdateSourceTrigger=LostFocus}" Padding="4,1" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, Converter={StaticResource Money}, Mode=OneWay}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
