<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.ProductEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure"
             Width="1200" Height="700">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}" Margin="0,16,0,0">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{l:T ProductEditor.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0" MinWidth="120" />
        </StackPanel>
        <Grid infra:LayoutMemory.Key="ProductEditor">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{l:T ProductEditor.NameRequired}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T Common.Brand}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Brand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T ProductEditor.StyleCode}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StyleCode}" Tag="{l:T ProductEditor.Auto}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:T ProductEditor.CategoryRequired}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />
                    <TextBlock Text="{l:T Common.Supplier}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T ProductEditor.Department}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T ProductEditor.Season}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Season}" Tag="{l:T ProductEditor.SeasonHint}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:T ProductEditor.Material}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Material}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T ProductEditor.PriceRequired}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Price}" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T ProductEditor.UnitCost}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Cost}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MarginText}" Style="{StaticResource HintText}" Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Text="{l:T Common.Description}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Description}" Style="{StaticResource MultilineBox}" />
                    <CheckBox Content="{l:T ProductEditor.ActiveForSale}" IsChecked="{Binding IsActive}" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{l:T ProductEditor.GenerateTitle}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T ProductEditor.SizesCsv}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding SizesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T ProductEditor.ColoursCsv}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ColorsText, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T ProductEditor.ColoursHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{l:T ProductEditor.OpeningStock}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding OpeningStock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Grid.Column="6" Content="{l:T ProductEditor.Generate}" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" VerticalAlignment="Bottom" Margin="0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SizePresets}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{l:T ProductEditor.AddVariant}" Style="{StaticResource LinkButton}" Command="{Binding AddVariantCommand}" Margin="0" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource HintText}" Margin="0" Text="{l:T ProductEditor.VariantsHint}" />
                </DockPanel>

                <DataGrid ItemsSource="{Binding Variants}" IsReadOnly="False" RowHeight="38" infra:LayoutMemory.Key="ProductEditor.Variants">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Common.Size}" Binding="{Binding Size, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="{l:T Common.Colour}" Binding="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="{l:T Common.Sku}" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="{l:T Common.Barcode}" Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                        <DataGridTextColumn Header="{l:T ProductEditor.PriceOverride}" Binding="{Binding PriceOverride, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Width="105" />
                        <DataGridTextColumn Header="{l:T ProductEditor.CostOverride}" Binding="{Binding CostOverride, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Width="100" />
                        <DataGridTemplateColumn Header="{l:T Common.Stock}" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" Padding="6,2" MinHeight="28"
                                             ToolTip="{l:T ProductEditor.OpeningStockTip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T Products.ReorderAt}" Binding="{Binding ReorderLevel, UpdateSourceTrigger=LostFocus}" Width="90" />
                        <DataGridCheckBoxColumn Header="{l:T Common.Active}" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" Content="&#xE74D;" Foreground="{StaticResource DangerBrush}"
                                            ToolTip="{l:T ProductEditor.RemoveVariant}"
                                            Command="{Binding DataContext.RemoveVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
