<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.ProductEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1180" Height="680">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="Save product" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="Product name *" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Brand" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Brand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Style code (SKU prefix)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StyleCode}" Tag="auto" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Category *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />
                    <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Department" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Season" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Season}" Tag="e.g. SS26" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Material / composition" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Material}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Selling price *" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Price}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unit cost" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Cost}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MarginText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                    <CheckBox Content="Active (available for sale)" IsChecked="{Binding IsActive}" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Generate size × colour variants" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sizes (comma separated)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding SizesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Colours (comma separated)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding ColorsText, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Black, Navy, Olive" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Opening stock" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding OpeningStock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Grid.Column="6" Content="Generate" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" VerticalAlignment="Bottom" Margin="0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SizePresets}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="+ Add single variant" Style="{StaticResource LinkButton}" Command="{Binding AddVariantCommand}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedText}"
                               Text="Leave SKU/barcode blank to auto-generate. Stock for existing variants is changed on the Inventory screen." />
                </DockPanel>

                <DataGrid ItemsSource="{Binding Variants}" IsReadOnly="False" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding Size, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="COLOUR" Binding="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                        <DataGridTextColumn Header="PRICE OVERRIDE" Binding="{Binding PriceOverride, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Width="105" />
                        <DataGridTextColumn Header="COST OVERRIDE" Binding="{Binding CostOverride, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Width="100" />
                        <DataGridTemplateColumn Header="STOCK" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" Padding="4,1"
                                             ToolTip="Opening stock (new variants only)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="REORDER AT" Binding="{Binding ReorderLevel, UpdateSourceTrigger=LostFocus}" Width="85" />
                        <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" ToolTip="Remove variant"
                                            Command="{Binding DataContext.RemoveVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
