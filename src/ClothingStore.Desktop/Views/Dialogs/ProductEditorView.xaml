<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.ProductEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="{Binding SaveAndNewText}" Command="{Binding SaveAndNewCommand}" MinWidth="120" ToolTip="{l:T ProductEditor.SaveAndNewTip}" />
                <Button Content="{l:T ProductEditor.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0" MinWidth="120" />
            </StackPanel>
            <!-- Entering several similar products in a row -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <CheckBox IsChecked="{Binding KeepDetails}" Margin="0" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"
                          ToolTip="{l:T ProductEditor.KeepDetailsTip}">
                    <TextBlock Text="{l:T ProductEditor.KeepDetails}" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Text="{Binding SavedMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding SavedMessage, Converter={StaticResource HasValueToVis}}" />
            </StackPanel>
        </DockPanel>
        <Grid infra:LayoutMemory.Key="ProductEditor" infra:PanelFit.IsEnabled="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{l:T ProductEditor.NameRequired}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T Common.Brand}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T ProductEditor.StyleCode}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StyleCode, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T ProductEditor.Auto}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:T ProductEditor.CategoryRequired}" Style="{StaticResource FieldLabel}" />
                    <ComboBox infra:SmartCombo.IsEnabled="True" Tag="{l:T Common.TypeToSearch}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />
                    <TextBlock Text="{l:T Common.Supplier}" Style="{StaticResource FieldLabel}" />
                    <ComboBox infra:SmartCombo.IsEnabled="True" Tag="{l:T Common.TypeToSearch}" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T ProductEditor.Department}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T ProductEditor.Season}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Season, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T ProductEditor.SeasonHint}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:T ProductEditor.Material}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T ProductEditor.PriceRequired}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Price}" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T ProductEditor.UnitCost}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Cost}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MarginText}" Style="{StaticResource HintText}" Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Text="{l:T Common.Description}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineBox}" />
                    <CheckBox Content="{l:T ProductEditor.ActiveForSale}" IsChecked="{Binding IsActive}" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{l:T ProductEditor.GenerateTitle}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T ProductEditor.SizesCsv}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding SizesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T ProductEditor.ColoursCsv}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <!-- Suggests the shop's colours while typing; Tab or Enter takes one -->
                                <TextBox Text="{Binding ColorsText, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T ProductEditor.ColoursHint}"
                                         infra:TypeAhead.Items="{Binding ColorSuggestions}" infra:TypeAhead.IsList="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{l:T ProductEditor.OpeningStock}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding OpeningStock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Grid.Column="6" Content="{l:T ProductEditor.Generate}" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" VerticalAlignment="Bottom" Margin="0" />
                        </Grid>
                        <!-- A shop's many own buttons scroll here instead of squeezing the variants table -->
                        <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl ItemsSource="{Binding SizePresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- The store's own buttons have a small × to remove them -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                                        <Button Content="{Binding Name}" Style="{StaticResource SmallButton}" Margin="0" ToolTip="{Binding Sizes}"
                                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button x:Name="Remove" Style="{StaticResource LinkButton}" Foreground="{StaticResource MutedTextBrush}" Margin="0" Padding="5,4"
                                                Visibility="Collapsed" ToolTip="{l:T ProductEditor.PresetRemove}"
                                                Command="{Binding DataContext.RemovePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9" />
                                        </Button>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                            <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                        <Button Content="{l:T ProductEditor.SavePresetButton}" Style="{StaticResource LinkButton}" Command="{Binding SavePresetCommand}"
                                HorizontalAlignment="Left" Margin="0" ToolTip="{l:T ProductEditor.SavePresetTip}" />

                        <!-- The shop's most used colours: a click adds one to the colours box, a second click takes it off -->
                        <TextBlock Text="{l:T ProductEditor.ColourButtons}" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                        <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding ColorChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,6" ToolTip="{l:T ProductEditor.ColourButtonTip}"
                                                Command="{Binding DataContext.ToggleColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Swatch}"
                                                         Stroke="{StaticResource InputBorderBrush}" StrokeThickness="1"
                                                         Visibility="{Binding Swatch, Converter={StaticResource HasValueToVis}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{l:T ProductEditor.AddVariant}" Style="{StaticResource LinkButton}" Command="{Binding AddVariantCommand}" Margin="0" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource HintText}" Margin="0" Text="{l:T ProductEditor.VariantsHint}" />
                </DockPanel>

                <DataGrid x:Name="VariantsGrid" ItemsSource="{Binding Variants}" IsReadOnly="False" RowHeight="38" infra:LayoutMemory.Key="ProductEditor.Variants">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Common.Size}" Binding="{Binding Size, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn Header="{l:T Common.Colour}" Binding="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="110">
                            <DataGridTextColumn.EditingElementStyle>
                                <!-- The same colour suggestions while typing in the table -->
                                <Style TargetType="TextBox" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
                                    <Setter Property="infra:TypeAhead.Items" Value="{Binding DataContext.ColorSuggestions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{l:T Common.Sku}" Binding="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="130" />
                        <DataGridTextColumn Header="{l:T Common.Barcode}" Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="120" />
                        <DataGridTextColumn Header="{l:T ProductEditor.PriceOverride}" Binding="{Binding PriceOverride, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="105" />
                        <DataGridTextColumn Header="{l:T ProductEditor.CostOverride}" Binding="{Binding CostOverride, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="100" />
                        <DataGridTemplateColumn Header="{l:T Common.Stock}" Width="Auto" MinWidth="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" Style="{StaticResource CellBox}"
                                             ToolTip="{l:T ProductEditor.OpeningStockTip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T Products.ReorderAt}" Binding="{Binding ReorderLevel, UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="90" />
                        <DataGridCheckBoxColumn Header="{l:T Common.Active}" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="65" />
                        <DataGridTemplateColumn Width="52" MinWidth="52" MaxWidth="52" CanUserResize="False" CanUserReorder="False" CanUserSort="False" CellStyle="{StaticResource ActionCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE74D;" Foreground="{StaticResource DangerBrush}"
                                            ToolTip="{l:T ProductEditor.RemoveVariant}"
                                            Command="{Binding DataContext.RemoveVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
