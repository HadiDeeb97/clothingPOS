<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.OnlineReportsSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="620">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
            <Button Content="{l:T Online.SetUpButton}" Style="{StaticResource PrimaryButton}" Command="{Binding SetUpCommand}" IsDefault="True"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
            <TextBlock Text="{l:T Online.SetupIntro}" TextWrapping="Wrap" />

            <!-- With a Cloudflare token: the POS does the rest -->
            <StackPanel Visibility="{Binding UseExisting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <DockPanel Margin="0,16,0,0">
                    <Button DockPanel.Dock="Right" Content="{l:T Online.OpenSignUp}" Style="{StaticResource LinkButton}" Command="{Binding OpenSignUpPageCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{l:T Online.Step1}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Content="{l:T Online.OpenTokens}" Style="{StaticResource LinkButton}" Command="{Binding OpenTokensPageCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{l:T Online.Step2}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </DockPanel>
                <Border Style="{StaticResource InfoBanner}" Margin="0,8,0,0">
                    <TextBlock Text="{l:T Online.Permissions}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" FlowDirection="LeftToRight" />
                </Border>
                <TextBlock Text="{l:T Online.Step3}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,5" />
                <TextBox x:Name="TokenBox" Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FlowDirection="LeftToRight" />
                <CheckBox IsChecked="{Binding RememberToken}" Margin="0,10,0,0">
                    <TextBlock Text="{l:T Online.RememberToken}" TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>

            <!-- A website made by hand -->
            <StackPanel Visibility="{Binding UseExisting, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <TextBlock Text="{l:T Online.Address}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SiteUrl, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                <TextBlock Text="{l:T Online.Key}" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                <TextBox Text="{Binding UploadKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FlowDirection="LeftToRight" />
                <TextBlock Text="{l:T Online.ExistingHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" />
            </StackPanel>

            <CheckBox IsChecked="{Binding UseExisting}" Margin="0,16,0,0">
                <TextBlock Text="{l:T Online.UseExisting}" TextWrapping="Wrap" />
            </CheckBox>

            <TextBlock Text="{Binding Progress}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="{Binding Progress, Converter={StaticResource HasValueToVis}}" />
        </StackPanel>
    </DockPanel>
</UserControl>
