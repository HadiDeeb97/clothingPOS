<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.CustomerPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="640" Height="460">
    <DockPanel>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="Search by name, phone or email"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="+ New customer" Command="{Binding NewCommand}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="180,0,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="Select" Style="{StaticResource PrimaryButton}" Command="{Binding SelectCommand}" IsDefault="True" Margin="0" />
            </StackPanel>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedCustomer}" MouseDoubleClick="OnDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="120" />
                <DataGridTextColumn Header="POINTS" Binding="{Binding LoyaltyPoints}" Width="70" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="CREDIT" Binding="{Binding StoreCredit, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource RightCell}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
