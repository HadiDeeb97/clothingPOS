<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.CustomerPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="680" Height="480">
    <DockPanel>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="{l:T Customers.SearchHint}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Content="{l:T Customers.NewButton}" Command="{Binding NewCommand}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="{l:T Customers.SelectButton}" Style="{StaticResource PrimaryButton}" Command="{Binding SelectCommand}" IsDefault="True" Margin="0" MinWidth="90" />
            </StackPanel>
        </DockPanel>
        <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedCustomer}" MouseDoubleClick="OnDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:T Common.Name}" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="{l:T Common.Phone}" Binding="{Binding Phone}" Width="130" />
                <DataGridTextColumn Header="{l:T Common.Points}" Binding="{Binding LoyaltyPoints}" Width="80" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="{l:T Common.Credit}" Binding="{Binding StoreCredit, Converter={StaticResource Money}}" Width="100" ElementStyle="{StaticResource RightCell}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
