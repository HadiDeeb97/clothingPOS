<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="560">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Command="{Binding CancelCommand}" IsCancel="True">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="{l:T Common.Cancel}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Required}" Value="True">
                                <Setter Property="Content" Value="{l:T License.Exit}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{l:T License.Activate}" Style="{StaticResource PrimaryButton}" Command="{Binding ActivateCommand}" IsDefault="True" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <Border Style="{StaticResource Banner}">
                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>

            <TextBlock Text="{l:T License.MachineId}" Style="{StaticResource Caption}" Margin="0,18,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:T License.Copy}" Command="{Binding CopyMachineIdCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="SemiBold"
                         HorizontalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{l:T License.MachineIdHint}" Style="{StaticResource HintText}" />
            <TextBlock Text="{Binding Contact, StringFormat={l:T License.ContactFormat}}" Style="{StaticResource HintText}" FontWeight="SemiBold"
                       Visibility="{Binding HasContact, Converter={StaticResource BoolToVis}}" />

            <DockPanel Margin="0,18,0,4">
                <Button DockPanel.Dock="Right" Content="{l:T License.LoadFile}" Style="{StaticResource LinkButton}" Command="{Binding LoadFileCommand}" Margin="0" />
                <TextBlock Text="{l:T License.Key}" Style="{StaticResource Caption}" Margin="0" />
            </DockPanel>
            <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineBox}" MinHeight="90"
                     FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />
        </StackPanel>
    </DockPanel>
</UserControl>
