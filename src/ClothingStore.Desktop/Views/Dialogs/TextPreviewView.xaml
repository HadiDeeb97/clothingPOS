<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.TextPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Command="{Binding PrintCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                    <TextBlock Text="Print" />
                </StackPanel>
            </Button>
            <Button Content="{Binding CloseText}" Style="{StaticResource PrimaryButton}" Command="{Binding DoneCommand}" IsDefault="True" Margin="0" />
        </StackPanel>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" MaxHeight="620">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
