<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.TextPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}" Margin="0,18,0,0">
            <Button Command="{Binding PrintCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                    <TextBlock Text="{l:T Common.Print}" />
                </StackPanel>
            </Button>
            <Button Content="{Binding CloseText}" Style="{StaticResource PrimaryButton}" Command="{Binding DoneCommand}" IsDefault="True" Margin="0" MinWidth="90" />
        </StackPanel>
        <!-- The receipt is fixed-width text, so it always reads left to right. -->
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" MaxHeight="620"
                FlowDirection="LeftToRight">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
