<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.SettleDeliveriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="460">
    <StackPanel>
        <Border Style="{StaticResource InfoBanner}">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <TextBlock Text="{l:T Deliveries.HowPaid}" Style="{StaticResource FieldLabel}" />
        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Method" Content="{l:T Enum.SettlementMethod.Cash}" IsEnabled="{Binding HasOpenShift}"
                             IsChecked="{Binding Method, Converter={StaticResource Equals}, ConverterParameter=Cash}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Method" Content="{l:T Enum.SettlementMethod.CashLbp}" IsEnabled="{Binding HasOpenShift}"
                             Visibility="{Binding LbpEnabled, Converter={StaticResource BoolToVis}}"
                             IsChecked="{Binding Method, Converter={StaticResource Equals}, ConverterParameter=CashLbp}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="Method" Content="{l:T Enum.SettlementMethod.Transfer}"
                             IsChecked="{Binding Method, Converter={StaticResource Equals}, ConverterParameter=Transfer}" />
            </StackPanel>
        </Border>
        <TextBlock Text="{l:T Deliveries.CashNeedsShift}" Style="{StaticResource HintText}"
                   Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

        <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding ReceivedText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BigNumberBox}" />
        <TextBlock Text="{Binding DifferenceText}" Style="{StaticResource HintText}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />

        <TextBlock Text="{l:T Deliveries.Reference}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Style="{StaticResource DialogFooter}">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{l:T Deliveries.Record}" Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
