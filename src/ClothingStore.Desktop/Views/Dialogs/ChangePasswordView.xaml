<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360">
    <StackPanel>
        <Border Style="{StaticResource Banner}" Margin="0,0,0,8" Visibility="{Binding IsForced, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="For security, please replace your temporary password before continuing." TextWrapping="Wrap" />
        </Border>
        <TextBlock Text="Current password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="CurrentBox" PasswordChanged="OnChanged" />
        <TextBlock Text="New password (min. 6 characters)" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="NewBox" PasswordChanged="OnChanged" />
        <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="Change password" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</UserControl>
