<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="380">
    <StackPanel>
        <Border Style="{StaticResource Banner}" Margin="0,0,0,6" Visibility="{Binding IsForced, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{l:T Password.ForcedHint}" TextWrapping="Wrap" />
        </Border>
        <TextBlock Text="{l:T Password.Current}" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="CurrentBox" PasswordChanged="OnChanged" />
        <TextBlock Text="{l:T Password.New}" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="NewBox" PasswordChanged="OnChanged" />
        <TextBlock Text="{l:T Password.Confirm}" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnChanged" />
        <StackPanel Style="{StaticResource DialogFooter}">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{l:T Shell.ChangePassword}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</UserControl>
