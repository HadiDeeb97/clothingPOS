<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.ManagerApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360">
    <StackPanel>
        <Border Style="{StaticResource Banner}">
            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
        </Border>
        <TextBlock Text="Manager username" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
        <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="Approve" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveCommand}" IsDefault="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</UserControl>
