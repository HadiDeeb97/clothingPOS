<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.ManagerApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="400">
    <StackPanel>
        <Border Style="{StaticResource Banner}">
            <DockPanel>
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <TextBlock Text="{l:T Approval.Username}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
        <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{l:T Common.Password}" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}" />
        <StackPanel Style="{StaticResource DialogFooter}">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{l:T Approval.Approve}" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveCommand}" IsDefault="True" Margin="0" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</UserControl>
