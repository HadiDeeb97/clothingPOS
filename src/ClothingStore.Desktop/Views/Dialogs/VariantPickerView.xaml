<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.VariantPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             MinWidth="420">
    <StackPanel>
        <DockPanel Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Product.Price, Converter={StaticResource Money}}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Product.Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock Text="{l:T VariantPicker.Hint}" Style="{StaticResource HintText}" Margin="0,0,0,14" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="460">
            <StackPanel>
                <!-- Size headers -->
                <StackPanel Orientation="Horizontal" Margin="120,0,0,6">
                    <ItemsControl ItemsSource="{Binding SizeHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Width="78" Margin="0,0,6,0" TextAlignment="Center" Style="{StaticResource Caption}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- One row per colour -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Color}" Width="120" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="78" Height="56" Margin="0,0,6,0">
                                                <Button Margin="0" Padding="2" IsEnabled="{Binding CanSell}"
                                                        Visibility="{Binding Exists, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Size}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="StockText" Text="{Binding Stock}" FontSize="11.5" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </Button>
                                                <Border Visibility="{Binding Exists, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource SurfaceAltBrush}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                    <Setter TargetName="StockText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Style="{StaticResource DialogFooter}">
            <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</UserControl>
