<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.CustomerEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="First name *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FirstBox" Text="{Binding Customer.FirstName}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Last name" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Customer.LastName}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Customer.Phone}" />
        <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Customer.Email}" />
        <TextBlock Text="Birthday" Style="{StaticResource FieldLabel}" />
        <DatePicker SelectedDate="{Binding Customer.Birthday}" />
        <TextBlock Text="Notes (sizes, preferences…)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Customer.Notes}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalContentAlignment="Top" />
        <CheckBox Content="Active" IsChecked="{Binding Customer.IsActive}" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</UserControl>
