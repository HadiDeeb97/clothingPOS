<UserControl x:Class="ClothingStore.Desktop.Views.Dialogs.HeldSalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             Width="540" Height="400">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Content="{l:T Held.Discard}" Style="{StaticResource GhostButton}" Foreground="{StaticResource DangerBrush}" Command="{Binding DeleteCommand}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="{l:T Held.Resume}" Style="{StaticResource PrimaryButton}" Command="{Binding ResumeCommand}" IsDefault="True" Margin="0" MinWidth="90" />
            </StackPanel>
        </DockPanel>
        <Grid>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T Held.Label}" Binding="{Binding Label}" Width="*" MinWidth="140" />
                    <DataGridTextColumn Header="{l:T Held.HeldAt}" Binding="{Binding CreatedAt, StringFormat={}{0:ddd HH:mm}}" Width="Auto" MinWidth="130" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{l:T Held.None}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Items, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
        </Grid>
    </DockPanel>
</UserControl>
