<UserControl x:Class="ClothingStore.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure">
    <DockPanel>
        <DockPanel Style="{StaticResource Toolbar}" DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:T Products.PrintLabels}" Command="{Binding PrintLabelsCommand}" />
                <Button Content="{l:T Common.Delete}" Command="{Binding DeleteCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                <Button Content="{l:T Common.Edit}" Command="{Binding EditCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                <Button Content="{l:T Products.NewButton}" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="0"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource FilterBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{l:T Products.SearchHint}" Width="320" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Width="190" Margin="0,0,14,0" />
                <CheckBox Content="{l:T Common.IncludeInactive}" IsChecked="{Binding IncludeInactive}" />
            </StackPanel>
        </DockPanel>

        <Grid infra:LayoutMemory.Key="Products">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource TableCard}">
                <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          SelectionMode="Extended" infra:GridSelection.Items="{Binding Selection}"
                          MouseDoubleClick="OnDoubleClick" infra:LayoutMemory.Key="Products.List">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Product.IsActive}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Common.Product}" Binding="{Binding Product.Name}" Width="2*" MinWidth="140" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="{l:T Common.Brand}" Binding="{Binding Product.Brand}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="{l:T Common.Category}" Binding="{Binding Product.Category.Name}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="{l:T Products.For}" Binding="{Binding Product.Gender, Converter={StaticResource EnumDisplay}}" Width="Auto" MinWidth="80" />
                        <DataGridTextColumn Header="{l:T Products.Sizes}" Binding="{Binding Sizes}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="{l:T Products.Colours}" Binding="{Binding Colors}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="{l:T Common.Price}" Binding="{Binding Product.Price, Converter={StaticResource Money}}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTemplateColumn Header="{l:T Common.Stock}" Width="Auto" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalStock}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLowStock}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}" />

            <Border Grid.Row="2" Style="{StaticResource TableCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="16,14,16,10"
                               Text="{Binding SelectedProduct.Product.Name, StringFormat={l:T Products.VariantsOf}, FallbackValue=''}" />
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding SelectedProduct.Product.Variants}" infra:LayoutMemory.Key="Products.Variants">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Common.Size}" Binding="{Binding Size}" Width="Auto" MinWidth="80" />
                            <DataGridTextColumn Header="{l:T Common.Colour}" Binding="{Binding Color}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="{l:T Common.Sku}" Binding="{Binding Sku}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="{l:T Common.Barcode}" Binding="{Binding Barcode}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="{l:T Common.Price}" Binding="{Binding PriceOverride, Converter={StaticResource Money}, TargetNullValue={l:T Products.DefaultPrice}}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="{l:T Common.Stock}" Binding="{Binding StockQuantity}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource StrongRightCell}" />
                            <DataGridTextColumn Header="{l:T Products.ReorderAt}" Binding="{Binding ReorderLevel}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource RightCell}" />
                            <DataGridCheckBoxColumn Header="{l:T Common.Active}" Binding="{Binding IsActive}" Width="Auto" MinWidth="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
