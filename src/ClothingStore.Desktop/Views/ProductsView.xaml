<UserControl x:Class="ClothingStore.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="+ New product" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                <Button Content="Edit" Command="{Binding EditCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                <Button Content="Print labels" Command="{Binding PrintLabelsCommand}" Margin="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search name, brand, style, SKU or barcode" Width="300" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Width="180" Margin="0,0,10,0" />
                <CheckBox Content="Include inactive" IsChecked="{Binding IncludeInactive}" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" MouseDoubleClick="OnDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Product.IsActive}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Product.Name}" Width="2*" />
                    <DataGridTextColumn Header="BRAND" Binding="{Binding Product.Brand}" Width="*" />
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Product.Category.Name}" Width="*" />
                    <DataGridTextColumn Header="FOR" Binding="{Binding Product.Gender}" Width="70" />
                    <DataGridTextColumn Header="SIZES" Binding="{Binding Sizes}" Width="*" />
                    <DataGridTextColumn Header="COLOURS" Binding="{Binding Colors}" Width="*" />
                    <DataGridTextColumn Header="PRICE" Binding="{Binding Product.Price, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTemplateColumn Header="STOCK" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalStock}" HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLowStock}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{Binding SelectedProduct.Product.Name, StringFormat='Variants — {0}'}" />
                <DataGrid ItemsSource="{Binding SelectedProduct.Product.Variants}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="80" />
                        <DataGridTextColumn Header="COLOUR" Binding="{Binding Color}" Width="*" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*" />
                        <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" Width="*" />
                        <DataGridTextColumn Header="PRICE" Binding="{Binding PriceOverride, Converter={StaticResource Money}, TargetNullValue='(default)'}" Width="90" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="STOCK" Binding="{Binding StockQuantity}" Width="70" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="REORDER AT" Binding="{Binding ReorderLevel}" Width="90" ElementStyle="{StaticResource RightCell}" />
                        <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
