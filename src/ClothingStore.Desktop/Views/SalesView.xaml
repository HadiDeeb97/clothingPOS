<UserControl x:Class="ClothingStore.Desktop.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding SelectCustomerCommand}" />
        <KeyBinding Key="F6" Command="{Binding SetQuantityCommand}" />
        <KeyBinding Key="F7" Command="{Binding LineDiscountCommand}" />
        <KeyBinding Key="F8" Command="{Binding CartDiscountCommand}" />
        <KeyBinding Key="F9" Command="{Binding HoldCommand}" />
        <KeyBinding Key="F10" Command="{Binding ResumeCommand}" />
        <KeyBinding Key="F12" Command="{Binding PayCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left: scan + cart -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Margin="0,0,0,12"
                    Visibility="{Binding Session.HasOpenShift, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock TextWrapping="Wrap">
                    <Run FontWeight="SemiBold">No open shift.</Run>
                    <Run>Open the cash drawer (Cash Drawer screen) with your starting float before taking payments.</Run>
                </TextBlock>
            </Border>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                         Tag="Scan a barcode, or type a name, SKU, colour or size (F2)"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnSearchKeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>

            <!-- Line actions -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Quantity (F6)" Command="{Binding SetQuantityCommand}" />
                <Button Content="Line discount (F7)" Command="{Binding LineDiscountCommand}" />
                <Button Content="Remove item (Del)" Command="{Binding RemoveItemCommand}" CommandParameter="{x:Null}" />
                <Button Content="Clear sale" Command="{Binding ClearCartCommand}" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" />
            </StackPanel>

            <Grid>
                <DataGrid x:Name="CartGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" RowHeight="52"
                          PreviewKeyDown="OnCartKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ITEM" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                            <Run Text="{Binding VariantDescription, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding Sku, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PRICE" Width="90" Binding="{Binding UnitPrice, Converter={StaticResource Money}}" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTemplateColumn Header="QTY" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="−" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Quantity}" MinWidth="30" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" />
                                        <Button Content="+" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DISCOUNT" Width="140" Binding="{Binding DiscountDisplay}" ElementStyle="{StaticResource RightCell}" Foreground="{StaticResource SuccessBrush}" />
                        <DataGridTextColumn Header="TOTAL" Width="100" Binding="{Binding Total, Converter={StaticResource Money}}" FontWeight="SemiBold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" ToolTip="Remove" Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE7BF;" Style="{StaticResource Icon}" FontSize="48" Foreground="#D1D5DB" HorizontalAlignment="Center" />
                    <TextBlock Text="Scan an item to start a sale" Style="{StaticResource MutedText}" FontSize="15" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Search results overlay -->
                <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top" MaxHeight="420" Background="White"
                        Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" />
                    </Border.Effect>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="14,10">
                            <Button DockPanel.Dock="Right" Content="Close (Esc)" Style="{StaticResource LinkButton}" Command="{Binding CloseSearchCommand}" />
                            <TextBlock Text="Choose an item: ↓ then Enter, or double-click" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SearchMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                   Margin="14,0,14,12" Visibility="{Binding SearchMessage, Converter={StaticResource HasValueToVis}}" />
                        <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}" BorderThickness="0,1,0,0"
                                  MouseDoubleClick="OnResultDoubleClick" PreviewKeyDown="OnResultsKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PRODUCT" Binding="{Binding Product.Name}" Width="*" />
                                <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="70" />
                                <DataGridTextColumn Header="COLOUR" Binding="{Binding Color}" Width="110" />
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" />
                                <DataGridTextColumn Header="STOCK" Binding="{Binding StockQuantity}" Width="60" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="PRICE" Binding="{Binding EffectivePrice, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource RightCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- Right: customer, totals, actions -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="CUSTOMER" Style="{StaticResource MutedText}" FontSize="11" FontWeight="SemiBold" />
                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                Command="{Binding ClearCustomerCommand}" Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                    <StackPanel Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Customer.FullName}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Customer.Phone}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Customer.LoyaltyPoints, StringFormat={}{0} points}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding Customer.StoreCredit, Converter={StaticResource Money}, StringFormat='Credit {0}'}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Select customer (F4)" Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding SelectCustomerCommand}"
                            Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom">
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button Content="Cart discount (F8)" Command="{Binding CartDiscountCommand}" Margin="0,0,5,0" />
                    <Button Command="{Binding HoldCommand}" Margin="5,0,0,0" Content="Hold sale (F9)" />
                </UniformGrid>
                <Button Command="{Binding ResumeCommand}" Margin="0,0,0,10">
                    <TextBlock>
                        <Run Text="Resume held sale (F10)" />
                        <Run Text="{Binding HeldCount, StringFormat='· {0} waiting', Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" />
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource BigPayButton}" Command="{Binding PayCommand}" IsEnabled="{Binding HasItems}">
                    <TextBlock>
                        <Run Text="PAY  " />
                        <Run Text="{Binding Totals.Total, Converter={StaticResource Money}, Mode=OneWay}" />
                        <Run Text="  (F12)" FontSize="13" />
                    </TextBlock>
                </Button>
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="SUMMARY" Style="{StaticResource MutedText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DockPanel Margin="0,4">
                        <TextBlock Text="{Binding Totals.Subtotal, Converter={StaticResource Money}}" DockPanel.Dock="Right" />
                        <TextBlock>
                            <Run Text="Subtotal" />
                            <Run Text="{Binding ItemCount, StringFormat='({0} items)', Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                        </TextBlock>
                    </DockPanel>
                    <DockPanel Margin="0,4" Visibility="{Binding Totals.DiscountTotal, Converter={StaticResource HasValueToVis}}">
                        <TextBlock Text="{Binding Totals.DiscountTotal, Converter={StaticResource Money}, StringFormat='-{0}'}" DockPanel.Dock="Right" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Discounts" Foreground="{StaticResource SuccessBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding CartDiscountDisplay}" Style="{StaticResource MutedText}" FontSize="11"
                               Visibility="{Binding CartDiscountDisplay, Converter={StaticResource HasValueToVis}}" />
                    <DockPanel Margin="0,4">
                        <TextBlock Text="{Binding Totals.TaxTotal, Converter={StaticResource Money}}" DockPanel.Dock="Right" />
                        <TextBlock Text="{Binding TaxLabel}" />
                    </DockPanel>
                    <Separator Margin="0,10" />
                    <DockPanel>
                        <TextBlock Text="{Binding Totals.Total, Converter={StaticResource Money}}" DockPanel.Dock="Right" FontSize="30" FontWeight="Bold" />
                        <TextBlock Text="Total" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
