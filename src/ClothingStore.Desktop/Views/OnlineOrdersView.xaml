<UserControl x:Class="ClothingStore.Desktop.Views.OnlineOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="SummaryRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel Style="{StaticResource Toolbar}" DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="{l:T Orders.NewButton}" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="0" />
            <TextBox Style="{StaticResource FilterBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{l:T Orders.SearchHint}" Width="320" HorizontalAlignment="Left" />
        </DockPanel>

        <!-- Status tabs with counts -->
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Margin="0,0,0,12"
                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Chip" CornerRadius="16" Padding="14,6" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Visibility="{Binding Count, Converter={StaticResource HasValueToVis}}">
                            <TextBlock Text="{Binding Count}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid infra:LayoutMemory.Key="OnlineOrders">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource TableCard}">
                <Grid>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" infra:LayoutMemory.Key="OnlineOrders.List">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Orders.Number}" Binding="{Binding OrderNumber}" Width="130" />
                            <DataGridTextColumn Header="{l:T Orders.Date}" Binding="{Binding CreatedAt, StringFormat={}{0:dd MMM HH:mm}}" Width="105" />
                            <DataGridTextColumn Header="{l:T Orders.Channel}" Binding="{Binding Channel, Converter={StaticResource EnumDisplay}}" Width="95" />
                            <DataGridTextColumn Header="{l:T Common.Customer}" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="{l:T Common.Phone}" Binding="{Binding Phone}" Width="110" />
                            <DataGridTextColumn Header="{l:T Common.Total}" Binding="{Binding Total, Converter={StaticResource Money}}" Width="85" ElementStyle="{StaticResource StrongRightCell}" />
                            <DataGridTemplateColumn Header="{l:T Orders.Status}" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusChip" Style="{StaticResource Chip}">
                                            <TextBlock x:Name="StatusText" Text="{Binding Status, Converter={StaticResource EnumDisplay}}" FontSize="11.5" FontWeight="SemiBold" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="New">
                                                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource WarningLightBrush}" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#92400E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource InfoLightBrush}" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource InfoBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="OutForDelivery">
                                                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource SuccessLightBrush}" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#166534" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{l:T Orders.Empty}" Style="{StaticResource HintText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" MaxWidth="380" Visibility="{Binding Orders.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

            <!-- Order details and actions -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="{l:T Orders.SelectHint}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <DockPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource PrimaryLightBrush}">
                                    <TextBlock Text="{Binding Detail.Status, Converter={StaticResource EnumDisplay}}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Detail.OrderNumber}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource MutedText}">
                                        <Run Text="{Binding Detail.Channel, Converter={StaticResource EnumDisplay}, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Detail.CreatedAt, StringFormat=g, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding StatusHint}" Style="{StaticResource HintText}" />

                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Detail.CustomerName}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding Detail.Phone}" Visibility="{Binding Detail.Phone, Converter={StaticResource HasValueToVis}}" />
                                    <TextBlock Text="{Binding Detail.Handle}" Style="{StaticResource MutedText}" Visibility="{Binding Detail.Handle, Converter={StaticResource HasValueToVis}}" />
                                    <TextBlock Text="{Binding Detail.Address}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Detail.Address, Converter={StaticResource HasValueToVis}}" />
                                    <TextBlock Text="{Binding Detail.Notes}" Style="{StaticResource HintText}" Visibility="{Binding Detail.Notes, Converter={StaticResource HasValueToVis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <UniformGrid Columns="2">
                                <Button Content="{l:T Orders.Confirm}" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}" Margin="0,0,6,6" MinHeight="40" />
                                <Button Content="{l:T Orders.Send}" Command="{Binding OutForDeliveryCommand}" Margin="0,0,0,6" MinHeight="40" />
                            </UniformGrid>
                            <Button Content="{l:T Orders.Complete}" Style="{StaticResource SuccessButton}" Command="{Binding CompleteCommand}" MinHeight="46" Margin="0,0,0,6" />
                            <UniformGrid Columns="3">
                                <Button Content="{l:T Orders.WhatsApp}" Command="{Binding WhatsAppCommand}" Margin="0,0,6,6" />
                                <Button Content="{l:T Orders.CopyMessage}" Command="{Binding CopySummaryCommand}" Margin="0,0,6,6" />
                                <Button Content="{l:T Orders.DeliveryNote}" Command="{Binding DeliveryNoteCommand}" Margin="0,0,0,6" />
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <Button Content="{l:T Common.Edit}" Command="{Binding EditCommand}" Margin="0,0,6,0" />
                                <Button Content="{l:T Orders.CancelOrder}" Style="{StaticResource DangerButton}" Command="{Binding CancelOrderCommand}" />
                            </UniformGrid>
                        </StackPanel>

                        <!-- Totals -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Separator Margin="0,0,0,8" />
                            <DockPanel Style="{StaticResource SummaryRow}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail.ItemsTotal, Converter={StaticResource Money}}" />
                                <TextBlock Text="{l:T Orders.Items}" Style="{StaticResource MutedText}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource SummaryRow}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail.DeliveryFee, Converter={StaticResource Money}}" />
                                <TextBlock Text="{l:T Orders.DeliveryFee}" Style="{StaticResource MutedText}" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Detail.Total, Converter={StaticResource Money}}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding DetailLbp, Converter={StaticResource Lbp}}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Visibility="{Binding ShowLbp, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Text="{l:T Orders.ToCollect}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Detail.Lines}" Margin="0,12,0,0">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LineTotal, Converter={StaticResource Money}}" FontWeight="SemiBold" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Quantity, StringFormat={}{0} ×}" Width="36" Style="{StaticResource MutedText}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding VariantDescription}" Style="{StaticResource MutedText}" FontSize="11.5" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
