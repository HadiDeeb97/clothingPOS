<UserControl x:Class="ClothingStore.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Valuation KPIs -->
        <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="UNITS IN STOCK" Style="{StaticResource MutedText}" FontSize="11" />
                    <TextBlock Text="{Binding Valuation.Units}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="STOCK VALUE (COST)" Style="{StaticResource MutedText}" FontSize="11" />
                    <TextBlock Text="{Binding Valuation.CostValue, Converter={StaticResource Money}}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="RETAIL VALUE" Style="{StaticResource MutedText}" FontSize="11" />
                    <TextBlock Text="{Binding Valuation.RetailValue, Converter={StaticResource Money}}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="LOW STOCK" Style="{StaticResource MutedText}" FontSize="11" />
                    <TextBlock Text="{Binding Valuation.LowStockCount}" Style="{StaticResource KpiValue}" Foreground="{StaticResource WarningBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="OUT OF STOCK" Style="{StaticResource MutedText}" FontSize="11" />
                    <TextBlock Text="{Binding Valuation.OutOfStockCount}" Style="{StaticResource KpiValue}" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Adjust stock" Style="{StaticResource PrimaryButton}" Command="{Binding AdjustCommand}" />
                <Button Content="Stock count" Command="{Binding CountCommand}" />
                <Button Content="Reorder level" Command="{Binding ReorderLevelCommand}" />
                <Button Content="Print labels" Command="{Binding PrintLabelsCommand}" />
                <Button Content="Export CSV" Command="{Binding ExportCommand}" Margin="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search product, SKU, colour, size, barcode" Width="280" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Width="170" Margin="0,0,10,0" />
                <CheckBox Content="Low stock only" IsChecked="{Binding LowStockOnly}" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Product.Name}" Width="2*" />
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Product.Category.Name}" Width="*" />
                    <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="70" />
                    <DataGridTextColumn Header="COLOUR" Binding="{Binding Color}" Width="*" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*" />
                    <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" Width="120" />
                    <DataGridTextColumn Header="COST" Binding="{Binding EffectiveCost, Converter={StaticResource Money}}" Width="80" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="PRICE" Binding="{Binding EffectivePrice, Converter={StaticResource Money}}" Width="80" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="REORDER" Binding="{Binding ReorderLevel}" Width="70" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="ON HAND" Binding="{Binding StockQuantity}" Width="80" FontWeight="SemiBold" ElementStyle="{StaticResource RightCell}" />
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="Stock movement history" Style="{StaticResource SectionTitle}" />
                <DataGrid ItemsSource="{Binding Movements}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                        <DataGridTextColumn Header="TYPE" Binding="{Binding Type, Converter={StaticResource EnumDisplay}}" Width="130" />
                        <DataGridTextColumn Header="CHANGE" Binding="{Binding QuantityChange, StringFormat={}{0:+#;-#;0}}" Width="80" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="AFTER" Binding="{Binding QuantityAfter}" Width="70" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="150" />
                        <DataGridTextColumn Header="BY" Binding="{Binding User.FullName}" Width="130" />
                        <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
