<UserControl x:Class="ClothingStore.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure">
    <DockPanel>
        <!-- Valuation -->
        <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="0,0,0,14">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{l:T Inventory.UnitsInStock}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Valuation.Units}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{l:T Inventory.StockValueCost}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Valuation.CostValue, Converter={StaticResource Money}}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{l:T Inventory.RetailValue}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Valuation.RetailValue, Converter={StaticResource Money}}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{l:T Inventory.LowStock}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Valuation.LowStockCount}" Style="{StaticResource KpiValue}" Foreground="{StaticResource WarningBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="{l:T Inventory.OutOfStock}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Valuation.OutOfStockCount}" Style="{StaticResource KpiValue}" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel Style="{StaticResource Toolbar}" DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:T Common.ExportCsv}" Command="{Binding ExportCommand}" />
                <Button Content="{l:T Products.PrintLabels}" Command="{Binding PrintLabelsCommand}" />
                <Button Content="{l:T Inventory.ReorderLevel}" Command="{Binding ReorderLevelCommand}" />
                <Button Content="{l:T Inventory.StockCount}" Command="{Binding CountCommand}" />
                <Button Content="{l:T Inventory.AdjustStock}" Style="{StaticResource PrimaryButton}" Command="{Binding AdjustCommand}" Margin="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource FilterBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{l:T Inventory.SearchHint}" Width="300" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Width="180" Margin="0,0,14,0" />
                <CheckBox Content="{l:T Inventory.LowStockOnly}" IsChecked="{Binding LowStockOnly}" />
            </StackPanel>
        </DockPanel>

        <Grid infra:LayoutMemory.Key="Inventory">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource TableCard}">
                <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          SelectionMode="Extended" infra:GridSelection.Items="{Binding Selection}" infra:LayoutMemory.Key="Inventory.Items">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                    <Setter Property="Background" Value="#FFFBEB" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Common.Product}" Binding="{Binding Product.Name}" Width="2*" MinWidth="140" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="{l:T Common.Category}" Binding="{Binding Product.Category.Name}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="{l:T Common.Size}" Binding="{Binding Size}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn Header="{l:T Common.Colour}" Binding="{Binding Color}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="{l:T Common.Sku}" Binding="{Binding Sku}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="{l:T Common.Barcode}" Binding="{Binding Barcode}" Width="Auto" MinWidth="120" />
                        <DataGridTextColumn Header="{l:T Common.Cost}" Binding="{Binding EffectiveCost, Converter={StaticResource Money}}" Width="Auto" MinWidth="85" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="{l:T Common.Price}" Binding="{Binding EffectivePrice, Converter={StaticResource Money}}" Width="Auto" MinWidth="85" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="{l:T Products.ReorderAt}" Binding="{Binding ReorderLevel}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="{l:T Inventory.OnHand}" Binding="{Binding StockQuantity}" Width="Auto" MinWidth="85" ElementStyle="{StaticResource StrongRightCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}" />

            <Border Grid.Row="2" Style="{StaticResource TableCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T Inventory.MovementHistory}" Style="{StaticResource SectionTitle}" Margin="16,14,16,10" />
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Movements}" infra:LayoutMemory.Key="Inventory.Movements">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Common.Date}" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="Auto" MinWidth="140" />
                            <DataGridTextColumn Header="{l:T Common.Type}" Binding="{Binding Type, Converter={StaticResource EnumDisplay}}" Width="Auto" MinWidth="140" />
                            <DataGridTextColumn Header="{l:T Inventory.Change}" Binding="{Binding QuantityChange, StringFormat={}{0:+#;-#;0}}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource StrongRightCell}" />
                            <DataGridTextColumn Header="{l:T Inventory.After}" Binding="{Binding QuantityAfter}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="{l:T Common.Reference}" Binding="{Binding Reference}" Width="Auto" MinWidth="150" />
                            <DataGridTextColumn Header="{l:T Common.By}" Binding="{Binding User.FullName}" Width="Auto" MinWidth="130" />
                            <DataGridTextColumn Header="{l:T Common.Notes}" Binding="{Binding Notes}" Width="*" MinWidth="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
