<Window x:Class="ClothingStore.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
        xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure"
        Title="{Binding StoreName}"
        Width="1366" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Hidden while the sidebar is collapsed to icons -->
        <Style x:Key="ExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="UserMenuToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Sidebar ============================== -->
        <Border Background="{StaticResource SidebarBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="240" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Width" Value="76" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Brand -->
                <DockPanel DockPanel.Dock="Top" Margin="16,18,12,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE700;" Foreground="{StaticResource SidebarTextBrush}"
                            Command="{Binding ToggleSidebarCommand}" ToolTip="{l:T Shell.ToggleSidebar}" />
                    <StackPanel Orientation="Horizontal" Style="{StaticResource ExpandedOnly}">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryBrush}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="18" Foreground="White"
                                           Visibility="{Binding Branding.HasLogo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <Border CornerRadius="10" Background="White" Visibility="{Binding Branding.HasLogo, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding Branding.Icon}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding StoreName}" Foreground="White" FontSize="14.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="128" />
                            <TextBlock Text="{l:T Shell.PointOfSale}" Foreground="{StaticResource SidebarCaptionBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Signed-in user and their menu -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SidebarHoverBrush}" BorderThickness="0,1,0,0" Padding="8,10">
                    <Grid>
                        <ToggleButton x:Name="UserToggle" Style="{StaticResource UserMenuToggle}" IsChecked="{Binding IsUserMenuOpen, Mode=TwoWay}"
                                      ToolTip="{Binding Session.CurrentUser.FullName}">
                            <DockPanel>
                                <Border Style="{StaticResource Avatar}" Background="{StaticResource SidebarActiveBrush}">
                                    <TextBlock Text="{Binding Session.CurrentUser.FullName, Converter={StaticResource Initials}}" Foreground="White"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="10"
                                           Foreground="{StaticResource SidebarTextBrush}" Margin="6,0,2,0" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource ExpandedOnly}">
                                    <TextBlock Text="{Binding Session.CurrentUser.FullName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RoleDisplay}" Foreground="{StaticResource SidebarCaptionBrush}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=UserToggle}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
                            <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="6" Margin="10" MinWidth="230" Effect="{StaticResource PopupShadow}">
                                <StackPanel>
                                    <TextBlock Text="{l:T Shell.Language}" Style="{StaticResource Caption}" Margin="12,6,12,4" />
                                    <Button Style="{StaticResource MenuItemButton}" Command="{Binding SetLanguageCommand}" CommandParameter="en">
                                        <DockPanel>
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Width="22" Foreground="{StaticResource PrimaryBrush}"
                                                       Visibility="{Binding IsArabic, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <TextBlock Text="{l:T Shell.LanguageEnglish}" Margin="8,0,0,0" />
                                        </DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource MenuItemButton}" Command="{Binding SetLanguageCommand}" CommandParameter="ar">
                                        <DockPanel>
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Width="22" Foreground="{StaticResource PrimaryBrush}"
                                                       Visibility="{Binding IsArabic, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{l:T Shell.LanguageArabic}" Margin="8,0,0,0" />
                                        </DockPanel>
                                    </Button>
                                    <Separator Margin="6,6" />
                                    <Button Style="{StaticResource MenuItemButton}" Command="{Binding ChangePasswordCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" Width="22" />
                                            <TextBlock Text="{l:T Shell.ChangePassword}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MenuItemButton}" Command="{Binding ResetLayoutCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9A6;" Style="{StaticResource Icon}" Width="22" />
                                            <TextBlock Text="{l:T Shell.ResetLayout}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource MenuItemButton}" Command="{Binding SignOutCommand}" Foreground="{StaticResource DangerBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Width="22" />
                                            <TextBlock Text="{l:T Shell.SignOut}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavGroups}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,4">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource SidebarCaptionBrush}" FontSize="10.5" FontWeight="SemiBold"
                                               Margin="24,6,12,6" Style="{StaticResource ExpandedOnly}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" ToolTip="{Binding Title}"
                                                             ToolTipService.IsEnabled="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" Command="{Binding NavigateCommand}">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Width="20" />
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                                Visibility="{Binding Badge, Converter={StaticResource HasValueToVis}}">
                                                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                                                   Style="{StaticResource ExpandedOnly}" />
                                                    </DockPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================== Content ============================== -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="24,0" Height="64">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- LBP rate: everyone sees it, managers and admins can change it from here -->
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ChangeRateCommand}" Margin="0,0,10,0" Padding="12,5"
                                ToolTip="{l:T Rate.Tooltip}" Visibility="{Binding ShowRate, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0"
                                           Visibility="{Binding CanChangeRate, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Button>
                        <Border CornerRadius="14" Padding="12,5" Margin="0,0,16,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="#92400E" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Session.HasOpenShift}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                                            <Setter Property="TextElement.Foreground" Value="#166534" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Session.ShiftDisplay}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Now, StringFormat={}{0:ddd d MMM  HH:mm}}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Grid>
                <ContentControl Content="{Binding CurrentPage}" Margin="24,20,24,20" Focusable="False" />

                <!-- Toasts -->
                <ItemsControl ItemsSource="{Binding Items, Source={x:Static infra:ToastHost.Instance}}"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="14,11" Margin="0,8,0,0" MinWidth="280" MaxWidth="420" Background="#0F172A"
                                    Effect="{StaticResource PopupShadow}">
                                <DockPanel>
                                    <TextBlock x:Name="Glyph" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="#4ADE80" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" FontSize="13" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Info">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE946;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="#93C5FD" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="#FCD34D" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
