<Window x:Class="ClothingStore.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding StoreName, StringFormat={}{0} — Point of Sale}"
        Width="1366" Height="800" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Background="{StaticResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="20,20,20,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="22" Foreground="White" />
                    <TextBlock Text="{Binding StoreName}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Point of Sale" Foreground="{StaticResource SidebarTextBrush}" FontSize="11" Margin="32,2,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,16">
                <Button Command="{Binding ChangePasswordCommand}" Background="Transparent" BorderBrush="Transparent"
                        Foreground="{StaticResource SidebarTextBrush}" HorizontalContentAlignment="Left" Margin="0,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                        <TextBlock Text="Change password" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SignOutCommand}" Background="Transparent" BorderBrush="Transparent"
                        Foreground="{StaticResource SidebarTextBrush}" Margin="0,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                        <TextBlock Text="Sign out" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Command="{Binding NavigateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Content -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="12" Padding="10,4" Margin="0,0,16,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource WarningLightBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Session.HasOpenShift}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Session.ShiftDisplay}" FontSize="12" />
                        </Border>
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Session.UserDisplay}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding Now, StringFormat={}{0:ddd d MMM  HH:mm}}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Margin="24,16,24,20" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
