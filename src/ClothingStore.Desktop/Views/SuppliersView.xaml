<UserControl x:Class="ClothingStore.Desktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SUPPLIER" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="CONTACT" Binding="{Binding ContactName}" Width="*" />
                <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="120" />
                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="*" />
                <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="+ New" Style="{StaticResource LinkButton}" Command="{Binding NewCommand}" />
                    <TextBlock Text="Supplier details" Style="{StaticResource SectionTitle}" />
                </DockPanel>
                <TextBlock Text="Name *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Editing.Name}" />
                <TextBlock Text="Contact person" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Editing.ContactName}" />
                <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Editing.Phone}" />
                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Editing.Email}" />
                <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Editing.Address}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                <TextBlock Text="Notes (terms, lead time…)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Editing.Notes}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
