<UserControl x:Class="ClothingStore.Desktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure">
    <Grid infra:LayoutMemory.Key="Suppliers">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="400" MinWidth="320" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource TableCard}">
            <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" infra:LayoutMemory.Key="Suppliers.List">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T Common.Supplier}" Binding="{Binding Name}" Width="*" MinWidth="140" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="{l:T Suppliers.Contact}" Binding="{Binding ContactName}" Width="*" MinWidth="140" />
                    <DataGridTextColumn Header="{l:T Common.Phone}" Binding="{Binding Phone}" Width="Auto" MinWidth="130" />
                    <DataGridTextColumn Header="{l:T Common.Email}" Binding="{Binding Email}" Width="*" MinWidth="140" />
                    <DataGridCheckBoxColumn Header="{l:T Common.Active}" Binding="{Binding IsActive}" Width="Auto" MinWidth="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="{l:T Suppliers.NewButton}" Style="{StaticResource LinkButton}" Command="{Binding NewCommand}" Margin="0" />
                        <TextBlock Text="{l:T Suppliers.Details}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{l:T Suppliers.NameRequired}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editing.Name}" />
                    <TextBlock Text="{l:T Suppliers.ContactPerson}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editing.ContactName}" />
                    <TextBlock Text="{l:T Common.Phone}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editing.Phone}" />
                    <TextBlock Text="{l:T Common.Email}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editing.Email}" />
                    <TextBlock Text="{l:T Common.Address}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editing.Address}" Style="{StaticResource MultilineBox}" />
                    <TextBlock Text="{l:T Suppliers.NotesLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Editing.Notes}" Style="{StaticResource MultilineBox}" />
                    <CheckBox Content="{l:T Common.Active}" IsChecked="{Binding Editing.IsActive}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="{l:T Common.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="90" />
                        <Button Content="{l:T Common.Delete}" Style="{StaticResource GhostButton}" Foreground="{StaticResource DangerBrush}" Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
