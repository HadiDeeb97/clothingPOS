<UserControl x:Class="ClothingStore.Desktop.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBox x:Name="ReceiptBox" Style="{StaticResource SearchBox}" Width="320" Tag="Scan or type receipt number"
                     Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FindCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Find receipt" Style="{StaticResource PrimaryButton}" Command="{Binding FindCommand}" />
            <Button Content="Clear" Command="{Binding ClearCommand}" />
            <TextBlock Text="Tip: find a sale in Sales History and click “Return items”." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Grid Visibility="{Binding HasSale, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                    <WrapPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="RECEIPT" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding Sale.ReceiptNumber}" FontWeight="SemiBold" FontSize="15" />
                        </StackPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="DATE" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding Sale.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="15" />
                        </StackPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="CUSTOMER" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding Sale.Customer.FullName, TargetNullValue='Walk-in', FallbackValue='Walk-in'}" FontSize="15" />
                        </StackPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="TOTAL PAID" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding Sale.Total, Converter={StaticResource Money}}" FontSize="15" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
                <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Margin="0,0,0,12"
                        Visibility="{Binding IsOutsideWindow, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding WindowMessage}" TextWrapping="Wrap" />
                </Border>
                <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="False" RowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ITEM" Width="*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Line.ProductName}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                            <Run Text="{Binding Line.VariantDescription, Mode=OneWay}" /> · <Run Text="{Binding Line.Sku, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="SOLD" Binding="{Binding Line.Quantity}" Width="60" IsReadOnly="True" />
                        <DataGridTextColumn Header="RETURNED" Binding="{Binding Line.ReturnedQuantity}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="PAID EACH" Binding="{Binding UnitRefund, Converter={StaticResource Money}}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTemplateColumn Header="RETURN QTY" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="4,2" HorizontalContentAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="RESTOCK" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Restock, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="REFUND" Binding="{Binding EstimatedRefund, Converter={StaticResource Money}}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RightCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Button Content="Return all remaining items" Command="{Binding ReturnAllCommand}" Margin="0,0,0,8" />
                    <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding ReasonPresets}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Refund to" Style="{StaticResource FieldLabel}" />
                    <RadioButton Content="Cash" GroupName="Refund" IsChecked="{Binding RefundMethod, Converter={StaticResource Equals}, ConverterParameter=Cash}" />
                    <RadioButton Content="Card" GroupName="Refund" IsChecked="{Binding RefundMethod, Converter={StaticResource Equals}, ConverterParameter=Card}" />
                    <RadioButton Content="Store credit (for exchanges)" GroupName="Refund" IsEnabled="{Binding CanRefundToCredit}"
                                 IsChecked="{Binding RefundMethod, Converter={StaticResource Equals}, ConverterParameter=StoreCredit}" />
                    <Separator Margin="0,12" />
                    <DockPanel>
                        <TextBlock Text="{Binding EstimatedRefund, Converter={StaticResource Money}}" DockPanel.Dock="Right" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Refund" FontSize="16" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button Content="Process refund" Style="{StaticResource BigPayButton}" Margin="0,14,0,0" Command="{Binding ProcessCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="Look up the original receipt to start a return." Style="{StaticResource MutedText}" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasSale, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
    </DockPanel>
</UserControl>
