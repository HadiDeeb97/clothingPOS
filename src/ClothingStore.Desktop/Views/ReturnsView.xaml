<UserControl x:Class="ClothingStore.Desktop.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure">
    <DockPanel>
        <DockPanel Style="{StaticResource Toolbar}" DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{l:T Returns.Tip}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ReceiptBox" Style="{StaticResource SearchBox}" Width="340" Tag="{l:T Returns.ReceiptHint}"
                         Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding FindCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="{l:T Returns.Find}" Style="{StaticResource PrimaryButton}" Command="{Binding FindCommand}" MinHeight="44" />
                <Button Content="{l:T Common.Clear}" Command="{Binding ClearCommand}" MinHeight="44" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid Visibility="{Binding HasSale, Converter={StaticResource BoolToVis}}" infra:LayoutMemory.Key="Returns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="460" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="360" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14">
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="{l:T Common.Receipt}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Sale.ReceiptNumber}" FontWeight="SemiBold" FontSize="15" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T Common.Date}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Sale.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="15" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T Common.Customer}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Sale.Customer.FullName, TargetNullValue={l:T Returns.WalkIn}, FallbackValue={l:T Returns.WalkIn}}" FontSize="15" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T Returns.TotalPaid}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Sale.Total, Converter={StaticResource Money}}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Margin="0,0,0,12"
                            Visibility="{Binding IsOutsideWindow, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding WindowMessage}" TextWrapping="Wrap" />
                    </Border>
                    <Border Style="{StaticResource TableCard}">
                        <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Lines}" IsReadOnly="False" RowHeight="50" infra:LayoutMemory.Key="Returns.Lines">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:T Common.Item}" Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Line.ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Line.VariantDescription}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Line.Sku}" Style="{StaticResource MutedText}" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T Returns.Sold}" Binding="{Binding Line.Quantity}" Width="65" IsReadOnly="True" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="{l:T History.Returned}" Binding="{Binding Line.ReturnedQuantity}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="{l:T Returns.PaidEach}" Binding="{Binding UnitRefund, Converter={StaticResource Money}}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTemplateColumn Header="{l:T Returns.ReturnQty}" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="4,2" MinHeight="30" HorizontalContentAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T Returns.Restock}" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Restock, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T Returns.Refund}" Binding="{Binding EstimatedRefund, Converter={StaticResource Money}}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource StrongRightCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Button Content="{l:T Returns.ReturnAll}" Command="{Binding ReturnAllCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                        <TextBlock Text="{l:T Common.Reason}" Style="{StaticResource FieldLabel}" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding ReasonPresets}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{l:T Returns.RefundTo}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding PaidWith}" Style="{StaticResource HintText}" Margin="0,0,0,6" />
                        <RadioButton Content="{l:T Returns.ToOriginal}" GroupName="Refund"
                                     IsChecked="{Binding RefundTo, Converter={StaticResource Equals}, ConverterParameter=OriginalPayment}" />
                        <RadioButton Content="{l:T Returns.ToCredit}" GroupName="Refund" IsEnabled="{Binding CanRefundToCredit}"
                                     IsChecked="{Binding RefundTo, Converter={StaticResource Equals}, ConverterParameter=StoreCredit}" />
                        <RadioButton Content="{l:T Returns.ToCash}" GroupName="Refund" IsEnabled="{Binding CanRefundInCash}"
                                     IsChecked="{Binding RefundTo, Converter={StaticResource Equals}, ConverterParameter=Cash}" />
                        <TextBlock Text="{l:T Returns.StoreFundsHint}" Style="{StaticResource HintText}" />
                        <StackPanel Visibility="{Binding ShowLbp, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{l:T Returns.CashIn}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="RefundCash" Content="{l:T Returns.CashAsPaid}"
                                                 IsChecked="{Binding RefundCashIn, Converter={StaticResource Equals}, ConverterParameter=AsPaid}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="RefundCash" Content="{l:T Enum.CashCurrency.Usd}"
                                                 IsChecked="{Binding RefundCashIn, Converter={StaticResource Equals}, ConverterParameter=Usd}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="RefundCash" Content="{l:T Enum.CashCurrency.Lbp}"
                                                 IsChecked="{Binding RefundCashIn, Converter={StaticResource Equals}, ConverterParameter=Lbp}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{l:T Returns.CashInHint}" Style="{StaticResource HintText}" />
                        </StackPanel>
                        <Separator Margin="0,14" />
                        <DockPanel>
                            <TextBlock Text="{Binding EstimatedRefund, Converter={StaticResource Money}}" DockPanel.Dock="Right" FontSize="28" FontWeight="Bold" />
                            <TextBlock Text="{l:T Returns.Refund}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <Button Content="{l:T Returns.Process}" Style="{StaticResource BigPayButton}" Margin="0,16,0,0" Command="{Binding ProcessCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSale, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource PrimaryBrush}" />
                </Border>
                <TextBlock Text="{l:T Returns.Empty}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,14,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
