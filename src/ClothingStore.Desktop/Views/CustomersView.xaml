<UserControl x:Class="ClothingStore.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="+ New customer" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" />
                <Button Content="Edit" Command="{Binding EditCommand}" />
                <Button Content="Adjust store credit" Command="{Binding AdjustCreditCommand}" Visibility="{Binding CanAdjustCredit, Converter={StaticResource BoolToVis}}" />
                <Button Content="Export CSV" Command="{Binding ExportCommand}" Margin="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Tag="Search name, phone, email" Width="300" Margin="0,0,12,0" />
                <CheckBox Content="Include inactive" IsChecked="{Binding IncludeInactive}" />
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" MouseDoubleClick="OnDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="120" />
                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="POINTS" Binding="{Binding LoyaltyPoints}" Width="70" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="CREDIT" Binding="{Binding StoreCredit, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource RightCell}" />
                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding SelectedCustomer, Converter={StaticResource HasValueToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding SelectedCustomer.FullName}" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <TextBlock Text="{Binding SelectedCustomer.CreatedAt, StringFormat='Customer since {0:MMM yyyy}'}" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding SelectedCustomer.Notes}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding SelectedCustomer.Notes, Converter={StaticResource HasValueToVis}}" />
                        <UniformGrid Columns="3" Margin="0,12">
                            <StackPanel>
                                <TextBlock Text="VISITS" Style="{StaticResource MutedText}" FontSize="11" />
                                <TextBlock Text="{Binding VisitCount}" Style="{StaticResource KpiValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="LIFETIME SPEND" Style="{StaticResource MutedText}" FontSize="11" />
                                <TextBlock Text="{Binding LifetimeSpend, Converter={StaticResource Money}}" Style="{StaticResource KpiValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="POINTS" Style="{StaticResource MutedText}" FontSize="11" />
                                <TextBlock Text="{Binding SelectedCustomer.LoyaltyPoints}" Style="{StaticResource KpiValue}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Purchase history" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding History}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="90" />
                            <DataGridTextColumn Header="RECEIPT" Binding="{Binding ReceiptNumber}" Width="*" />
                            <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemCount}" Width="50" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, Converter={StaticResource Money}}" Width="80" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
