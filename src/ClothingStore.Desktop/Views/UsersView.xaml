<UserControl x:Class="ClothingStore.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure">
    <DockPanel>
        <DockPanel Style="{StaticResource Toolbar}" DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:T Users.ResetPassword}" Command="{Binding ResetPasswordCommand}" />
                <Button Content="{Binding ToggleActiveText}" Command="{Binding ToggleActiveCommand}" />
                <Button Content="{l:T Common.Delete}" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                <Button Content="{l:T Users.EditButton}" Command="{Binding EditCommand}" />
                <Button Content="{l:T Users.NewButton}" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="0" />
            </StackPanel>
            <TextBlock Text="{Binding ScopeHint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource InfoBanner}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{l:T Users.RoleCashier}" TextWrapping="Wrap" Margin="0,2" />
                <TextBlock Text="{l:T Users.RoleManager}" TextWrapping="Wrap" Margin="0,2" />
                <TextBlock Text="{l:T Users.RoleAdmin}" TextWrapping="Wrap" Margin="0,2" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource TableCard}">
            <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" MouseDoubleClick="OnDoubleClick"
                      infra:LayoutMemory.Key="Users.List">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T Common.Username}" Binding="{Binding Username}" Width="*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="{l:T Common.FullName}" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="{l:T Common.Role}" Binding="{Binding Role, Converter={StaticResource EnumDisplay}}" Width="120" />
                    <DataGridCheckBoxColumn Header="{l:T Common.Active}" Binding="{Binding IsActive}" Width="70" />
                    <DataGridTextColumn Header="{l:T Users.LastSignIn}" Binding="{Binding LastLoginAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
