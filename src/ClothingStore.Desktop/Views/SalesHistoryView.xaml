<UserControl x:Class="ClothingStore.Desktop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <DatePicker SelectedDate="{Binding From}" Width="130" Margin="0,0,6,0" />
            <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding To}" Width="130" Margin="0,0,10,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Receipt, customer, product or SKU" Width="260" Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <CheckBox Content="Show voided" IsChecked="{Binding IncludeVoided}" Margin="0,0,10,0" />
            <Button Content="Search" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" />
            <Button Content="Today" Style="{StaticResource LinkButton}" Command="{Binding QuickRangeCommand}" CommandParameter="today" />
            <Button Content="Yesterday" Style="{StaticResource LinkButton}" Command="{Binding QuickRangeCommand}" CommandParameter="yesterday" />
            <Button Content="Last 7 days" Style="{StaticResource LinkButton}" Command="{Binding QuickRangeCommand}" CommandParameter="week" />
            <Button Content="This month" Style="{StaticResource LinkButton}" Command="{Binding QuickRangeCommand}" CommandParameter="month" />
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14">
                <Run Text="{Binding SaleCount, Mode=OneWay}" /> sales ·
                <Run Text="{Binding TotalSales, Converter={StaticResource Money}, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <Button Content="Reprint receipt" Command="{Binding ReprintCommand}" />
                <Button Content="Return items" Command="{Binding ReturnCommand}" Visibility="{Binding CanReturn, Converter={StaticResource BoolToVis}}" />
                <Button Content="Void sale" Style="{StaticResource DangerButton}" Command="{Binding VoidCommand}" Visibility="{Binding CanVoid, Converter={StaticResource BoolToVis}}" />
                <Button Content="Export CSV" Command="{Binding ExportCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Voided">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="RECEIPT" Binding="{Binding ReceiptNumber}" Width="140" />
                    <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat={}{0:dd MMM HH:mm}}" Width="110" />
                    <DataGridTextColumn Header="CASHIER" Binding="{Binding User.FullName}" Width="*" />
                    <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Customer.FullName}" Width="*" />
                    <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemCount}" Width="60" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding SelectedSale, Converter={StaticResource HasValueToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding SelectedSale.ReceiptNumber}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding SelectedSale.VoidReason, StringFormat='Voided: {0}'}"
                                   Visibility="{Binding SelectedSale.VoidReason, Converter={StaticResource HasValueToVis}}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.Subtotal, Converter={StaticResource Money}}" /><TextBlock Text="Subtotal" /></DockPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.DiscountTotal, Converter={StaticResource Money}, StringFormat='-{0}'}" /><TextBlock Text="Discounts" /></DockPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.TaxTotal, Converter={StaticResource Money}}" /><TextBlock Text="Tax" /></DockPanel>
                        <DockPanel Margin="0,4,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.Total, Converter={StaticResource Money}}" FontWeight="Bold" FontSize="16" /><TextBlock Text="Total" FontWeight="Bold" FontSize="16" /></DockPanel>
                        <TextBlock Text="PAYMENTS" Style="{StaticResource MutedText}" FontSize="11" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding SelectedSale.Payments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Money}}" />
                                        <TextBlock Text="{Binding Method, Converter={StaticResource EnumDisplay}}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding SelectedSale.Lines}" BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="VARIANT" Binding="{Binding VariantDescription}" Width="90" />
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="40" />
                            <DataGridTextColumn Header="RET" Binding="{Binding ReturnedQuantity}" Width="40" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, Converter={StaticResource Money}}" Width="80" ElementStyle="{StaticResource RightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
