<UserControl x:Class="ClothingStore.Desktop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
             xmlns:infra="clr-namespace:ClothingStore.Desktop.Infrastructure"
             xmlns:data="clr-namespace:ClothingStore.Data.Services;assembly=ClothingStore.Data">
    <DockPanel>
        <!-- Filters -->
        <DockPanel Style="{StaticResource Toolbar}" DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="{l:T Common.ExportCsv}" Command="{Binding ExportCommand}" Margin="0" />
            <WrapPanel>
                <TextBox Style="{StaticResource FilterBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{l:T History.SearchHint}" Width="280" Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <DatePicker SelectedDate="{Binding From}" MinWidth="135" Margin="0,0,6,0" />
                <TextBlock Text="{l:T Common.To}" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding To}" MinWidth="135" Margin="0,0,10,0" />
                <Button Content="{l:T Common.Today}" Style="{StaticResource LinkButton}" Command="{Binding QuickRangeCommand}" CommandParameter="today" Margin="0" />
                <Button Content="{l:T Common.Yesterday}" Style="{StaticResource LinkButton}" Command="{Binding QuickRangeCommand}" CommandParameter="yesterday" Margin="0" />
                <Button Content="{l:T Common.Last7Days}" Style="{StaticResource LinkButton}" Command="{Binding QuickRangeCommand}" CommandParameter="week" Margin="0" />
                <Button Content="{l:T Common.ThisMonth}" Style="{StaticResource LinkButton}" Command="{Binding QuickRangeCommand}" CommandParameter="month" Margin="0,0,10,0" />
                <Border Style="{StaticResource SegmentGroup}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Source" Content="{l:T History.SourceAll}"
                                     IsChecked="{Binding Source, Converter={StaticResource Equals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Source" Content="{l:T Enum.SalesChannel.InStore}"
                                     IsChecked="{Binding Source, Converter={StaticResource Equals}, ConverterParameter=InStore}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Source" Content="{l:T History.SourceOnline}"
                                     IsChecked="{Binding Source, Converter={StaticResource Equals}, ConverterParameter=Online}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Status" Content="{l:T History.FilterAll}"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Status" Content="{l:T History.FilterCompleted}"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Completed}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Status" Content="{l:T History.FilterWithReturns}"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=WithReturns}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Status" Content="{l:T History.FilterVoided}"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Voided}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </DockPanel>

        <Grid infra:LayoutMemory.Key="SalesHistory">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <!-- Summary: every sale in the dates, voided, returns, and what is left. Clicking a box lists just those. -->
                <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,-10,12">
                    <UniformGrid.Resources>
                        <Style x:Key="SummaryBox" TargetType="Button">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="0,0,10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Box" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="14,10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </UniformGrid.Resources>
                    <Button Style="{StaticResource SummaryBox}" Command="{Binding ShowOnlyCommand}" CommandParameter="{x:Static data:SaleListFilter.All}">
                        <StackPanel>
                            <TextBlock Text="{l:T History.SummarySales}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Summary.Total, Converter={StaticResource Money}}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary.Count, StringFormat={l:T History.SummaryCount}}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SummaryBox}" Command="{Binding ShowOnlyCommand}" CommandParameter="{x:Static data:SaleListFilter.Voided}">
                        <StackPanel>
                            <TextBlock Text="{l:T History.SummaryVoided}" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding Summary.VoidedTotal, Converter={StaticResource Money}, StringFormat='-{0}'}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding Summary.VoidedCount, StringFormat={l:T History.SummaryCount}}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SummaryBox}" Command="{Binding ShowOnlyCommand}" CommandParameter="{x:Static data:SaleListFilter.WithReturns}">
                        <StackPanel>
                            <TextBlock Text="{l:T History.SummaryReturns}" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="{Binding Summary.Refunded, Converter={StaticResource Money}, StringFormat='-{0}'}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="{Binding Summary.ReturnedCount, StringFormat={l:T History.SummaryCount}}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SummaryBox}" Command="{Binding ShowOnlyCommand}" CommandParameter="{x:Static data:SaleListFilter.Completed}">
                        <StackPanel>
                            <TextBlock Text="{l:T History.SummaryNet}" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{Binding Summary.Net, Converter={StaticResource Money}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{l:T History.SummaryNetHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource KpiCard}" Margin="0,12,0,0"
                        Visibility="{Binding HasFooter, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OnlineSummary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CappedText}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding IsCapped, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource TableCard}">
                    <Grid>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}"
                              infra:LayoutMemory.Key="SalesHistory.Sales">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Voided">
                                        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Common.Receipt}" Binding="{Binding ReceiptNumber}" Width="Auto" MinWidth="140" />
                            <DataGridTextColumn Header="{l:T Common.Date}" Binding="{Binding CreatedAt, StringFormat={}{0:dd MMM HH:mm}}" Width="Auto" MinWidth="110" />
                            <DataGridTemplateColumn Header="{l:T History.Source}" Width="Auto" MinWidth="110" SortMemberPath="Channel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SourcePill" Style="{StaticResource Chip}" Background="{StaticResource PrimaryLightBrush}">
                                            <TextBlock x:Name="SourceText" Text="{Binding Channel, Converter={StaticResource EnumDisplay}}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Channel}" Value="InStore">
                                                <Setter TargetName="SourcePill" Property="Background" Value="{StaticResource HoverBrush}" />
                                                <Setter TargetName="SourceText" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T Common.Cashier}" Binding="{Binding User.FullName}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="{l:T Common.Customer}" Binding="{Binding Customer.FullName}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="{l:T Common.Items}" Binding="{Binding ItemCount}" Width="Auto" MinWidth="60" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="{l:T Common.Total}" Binding="{Binding Total, Converter={StaticResource Money}}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTemplateColumn Header="{l:T History.ReturnedAmount}" Width="Auto" MinWidth="95" SortMemberPath="RefundedTotal">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RefundedTotal, Converter={StaticResource Money}, StringFormat='-{0}'}" Foreground="{StaticResource WarningBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0"
                                                   Visibility="{Binding HasReturns, Converter={StaticResource BoolToVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T History.Net}" Binding="{Binding NetTotal, Converter={StaticResource Money}}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource StrongRightCell}" />
                            <DataGridTemplateColumn Header="{l:T Common.Status}" Width="Auto" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Pill" Style="{StaticResource Chip}" Background="{StaticResource SuccessLightBrush}">
                                                <TextBlock x:Name="PillText" Text="{Binding Status, Converter={StaticResource EnumDisplay}}" FontSize="11.5" FontWeight="SemiBold" Foreground="#166534" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="{StaticResource WarningLightBrush}" Margin="4,0,0,0"
                                                    Visibility="{Binding HasReturns, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:T History.Returned}" FontSize="11.5" FontWeight="SemiBold" Foreground="#92400E" />
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Voided">
                                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource DangerLightBrush}" />
                                                <Setter TargetName="PillText" Property="Foreground" Value="#991B1B" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- While the newest sales load (dates, search or filter changed): the old list can't be read or used -->
                    <Border Background="{StaticResource SurfaceBrush}" Opacity="0.92" Cursor="Wait" CornerRadius="12"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{l:T History.Loading}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Height="3" Width="200" Margin="0,10,0,0" BorderThickness="0"
                                         Background="{StaticResource BorderBrush}" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

            <!-- Selected sale -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="{l:T History.SelectSale}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedSale, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                    <DockPanel Visibility="{Binding SelectedSale, Converter={StaticResource HasValueToVis}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedSale.ReceiptNumber}" FontSize="17" FontWeight="SemiBold" />
                            </DockPanel>
                            <!-- Where the purchase came from -->
                            <Border Margin="0,8,0,0" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSale.Channel}" Value="InStore">
                                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="SemiBold" Text="{Binding SelectedSale.Channel, Converter={StaticResource EnumDisplay}, StringFormat={l:T History.SourceFormat}}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedSale.Courier, StringFormat={l:T Register.CourierFormat}}" Style="{StaticResource HintText}"
                                       Visibility="{Binding SelectedSale.Courier, Converter={StaticResource HasValueToVis}}" />
                            <TextBlock Text="{Binding SelectedSale.DeliveryReference, StringFormat={l:T Register.DeliveryRefFormat}}" Style="{StaticResource HintText}"
                                       Visibility="{Binding SelectedSale.DeliveryReference, Converter={StaticResource HasValueToVis}}" />
                            <TextBlock Text="{Binding SelectedSale.Notes}" Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Visibility="{Binding SelectedSale.Notes, Converter={StaticResource HasValueToVis}}" />
                            <Border Style="{StaticResource DangerBanner}" Margin="0,10,0,0"
                                    Visibility="{Binding SelectedSale.VoidReason, Converter={StaticResource HasValueToVis}}">
                                <TextBlock Text="{Binding SelectedSale.VoidReason, StringFormat={l:T History.VoidedReason}}" Foreground="#991B1B" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.Subtotal, Converter={StaticResource Money}}" /><TextBlock Text="{l:T Common.Subtotal}" Style="{StaticResource MutedText}" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.DiscountTotal, Converter={StaticResource Money}, StringFormat='-{0}'}" /><TextBlock Text="{l:T Common.Discounts}" Style="{StaticResource MutedText}" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.TaxTotal, Converter={StaticResource Money}}" /><TextBlock Text="{l:T Common.Tax}" Style="{StaticResource MutedText}" /></DockPanel>
                            <DockPanel Margin="0,2" Visibility="{Binding SelectedSale.DeliveryFee, Converter={StaticResource HasValueToVis}}"><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.DeliveryFee, Converter={StaticResource Money}}" /><TextBlock Text="{l:T History.DeliveryFee}" Style="{StaticResource MutedText}" /></DockPanel>
                            <Separator />
                            <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSale.Total, Converter={StaticResource Money}}" FontWeight="Bold" FontSize="18" /><TextBlock Text="{l:T Common.Total}" FontWeight="SemiBold" FontSize="15" /></DockPanel>
                            <TextBlock Text="{l:T Common.Payments}" Style="{StaticResource Caption}" />
                            <ItemsControl ItemsSource="{Binding SelectedSale.Payments}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Money}}" />
                                            <TextBlock Text="{Binding Method, Converter={StaticResource EnumDisplay}}" />
                                            <!-- Card / wallet reference or auth code typed at the till -->
                                            <TextBlock Text="{Binding Reference, StringFormat='  ({0})'}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Visibility="{Binding Reference, Converter={StaticResource HasValueToVis}}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Content="{l:T History.Reprint}" Command="{Binding ReprintCommand}" Margin="0,0,8,8" />
                                <Button Content="{l:T History.ReturnItems}" Command="{Binding ReturnCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding CanReturn, Converter={StaticResource BoolToVis}}" />
                                <Button Content="{l:T History.VoidSale}" Style="{StaticResource DangerButton}" Command="{Binding VoidCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding CanVoid, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding SelectedSale.Lines}" Style="{StaticResource CardGrid}" infra:LayoutMemory.Key="SalesHistory.Lines">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T Common.Item}" Binding="{Binding ProductName}" Width="*" MinWidth="140" />
                                <DataGridTextColumn Header="{l:T History.Variant}" Binding="{Binding VariantDescription}" Width="Auto" MinWidth="100" />
                                <DataGridTextColumn Header="{l:T Common.Qty}" Binding="{Binding Quantity}" Width="Auto" MinWidth="50" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="{l:T History.Returned}" Binding="{Binding ReturnedQuantity}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource RightCell}" />
                                <DataGridTextColumn Header="{l:T Common.Total}" Binding="{Binding LineTotal, Converter={StaticResource Money}}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource RightCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
