<UserControl x:Class="ClothingStore.Desktop.Views.ShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- No open shift -->
                <Border Style="{StaticResource Card}" Visibility="{Binding Session.HasOpenShift, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="Open the cash drawer" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Count the starting cash (float) in the drawer and enter it below." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        <TextBlock Text="Opening float" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
                        <TextBox Text="{Binding OpeningFloatText, UpdateSourceTrigger=PropertyChanged}" FontSize="22" Width="200" HorizontalAlignment="Left" />
                        <Button Content="Open shift" Style="{StaticResource SuccessButton}" Command="{Binding OpenShiftCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" MinHeight="42" />
                    </StackPanel>
                </Border>

                <!-- Open shift summary -->
                <StackPanel Visibility="{Binding Session.HasOpenShift, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Print X report" Command="{Binding PrintXReportCommand}" Margin="0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Summary.OpenedAt, StringFormat='Current shift — opened {0:ddd HH:mm}'}" />
                            </DockPanel>
                            <UniformGrid Columns="3" Margin="0,10,0,0">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="SALES" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding Summary.SalesCount}" Style="{StaticResource KpiValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TOTAL SALES" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding Summary.TotalSales, Converter={StaticResource Money}}" Style="{StaticResource KpiValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="REFUNDS" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding Summary.TotalRefunds, Converter={StaticResource Money}}" Style="{StaticResource KpiValue}" />
                                </StackPanel>
                            </UniformGrid>
                            <Separator Margin="0,4,0,10" />
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Summary.OpeningFloat, Converter={StaticResource Money}}" /><TextBlock Text="Opening float" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Summary.CashSales, Converter={StaticResource Money}}" /><TextBlock Text="+ Cash sales" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Summary.PayIns, Converter={StaticResource Money}}" /><TextBlock Text="+ Pay-ins" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Summary.PayOuts, Converter={StaticResource Money}}" /><TextBlock Text="− Pay-outs" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Summary.CashRefunds, Converter={StaticResource Money}}" /><TextBlock Text="− Cash refunds" /></DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.ExpectedCash, Converter={StaticResource Money}}" FontWeight="Bold" FontSize="18" />
                                <TextBlock Text="Expected in drawer" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Cash in / out" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Pay-out (expense, bank drop)" GroupName="Move"
                                             IsChecked="{Binding MovementType, Converter={StaticResource Equals}, ConverterParameter=PayOut}" />
                                <RadioButton Content="Pay-in (add change)" GroupName="Move"
                                             IsChecked="{Binding MovementType, Converter={StaticResource Equals}, ConverterParameter=PayIn}" />
                            </StackPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MovementAmountText, UpdateSourceTrigger=PropertyChanged}" Tag="Amount" />
                                <TextBox Grid.Column="2" Text="{Binding MovementReason, UpdateSourceTrigger=PropertyChanged}" Tag="Reason" Margin="0,0,8,0" />
                                <Button Grid.Column="3" Content="Record" Command="{Binding AddMovementCommand}" Margin="0" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Summary.CashMovements}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Money}}" />
                                            <TextBlock>
                                                <Run Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                                                <Run Text="{Binding Type, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Reason, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="End of day — count &amp; close" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Count all cash in the drawer (including the float) and enter the total." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            <TextBlock Text="Counted cash" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                            <TextBox Text="{Binding CountedCashText, UpdateSourceTrigger=PropertyChanged}" FontSize="22" Width="200" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding VariancePreview}" Margin="0,6,0,0" FontWeight="SemiBold" />
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CloseNotes}" />
                            <Button Content="Close shift &amp; print Z report" Style="{StaticResource DangerButton}" Command="{Binding CloseShiftCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" MinHeight="42" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="View report" Command="{Binding ViewHistoryReportCommand}" Margin="0" />
                <TextBlock Text="Recent shifts" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="CASHIER" Binding="{Binding User.FullName}" Width="*" />
                    <DataGridTextColumn Header="OPENED" Binding="{Binding OpenedAt, StringFormat={}{0:dd MMM HH:mm}}" Width="110" />
                    <DataGridTextColumn Header="CLOSED" Binding="{Binding ClosedAt, StringFormat={}{0:dd MMM HH:mm}}" Width="110" />
                    <DataGridTextColumn Header="EXPECTED" Binding="{Binding ExpectedCash, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="COUNTED" Binding="{Binding CountedCash, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTemplateColumn Header="VARIANCE" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Variance, Converter={StaticResource Money}}" HorizontalAlignment="Right"
                                           Foreground="{Binding Variance, Converter={StaticResource SignBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
