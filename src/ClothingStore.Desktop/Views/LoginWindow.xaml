<Window x:Class="ClothingStore.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClothingStore.Desktop.Localization"
        Title="{l:T Login.WindowTitle}"
        Width="860" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="40">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="84" Height="84" CornerRadius="22" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="38" Foreground="White"
                                       Visibility="{Binding Branding.HasLogo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <Border Background="White" CornerRadius="22" Visibility="{Binding Branding.HasLogo, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding Branding.Icon}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding StoreName}" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,24,0,6" TextWrapping="Wrap" />
                    <TextBlock Text="{l:T Login.Tagline}" Foreground="{StaticResource SidebarTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="21" />
                </StackPanel>
                <TextBlock Text="{l:T Shell.AppName}" Foreground="{StaticResource SidebarCaptionBrush}" FontSize="11" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- Sign-in form -->
        <Grid Grid.Column="1" Margin="48,24,48,32">
            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Lang" Content="{l:T Shell.LanguageEnglish}"
                                 IsChecked="{Binding IsArabic, Mode=OneWay, Converter={StaticResource Not}}"
                                 Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Lang" Content="{l:T Shell.LanguageArabic}"
                                 IsChecked="{Binding IsArabic, Mode=OneWay}"
                                 Command="{Binding SetLanguageCommand}" CommandParameter="ar" />
                </StackPanel>
            </Border>

            <StackPanel VerticalAlignment="Center" MaxWidth="340">
                <TextBlock Text="{l:T Login.Welcome}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{l:T Login.Subtitle}" Style="{StaticResource MutedText}" Margin="0,6,0,22" />

                <TextBlock Text="{l:T Common.Username}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" FontSize="14" />
                <TextBlock Text="{l:T Common.Password}" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" MinHeight="42" FontSize="14" />

                <Border Style="{StaticResource DangerBanner}" Margin="0,14,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap" />
                </Border>

                <Button Content="{l:T Login.SignIn}" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" MinHeight="46" FontSize="15"
                        IsDefault="True" Command="{Binding SignInCommand}" />
                <TextBlock Text="{Binding Hint}" Style="{StaticResource HintText}" Margin="0,16,0,0" TextAlignment="Center"
                           Visibility="{Binding Hint, Converter={StaticResource HasValueToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
