<UserControl x:Class="ClothingStore.Desktop.Views.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="+ New order" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" />
                <Button Content="Edit" Command="{Binding EditCommand}" />
                <Button Content="Mark as ordered" Command="{Binding MarkOrderedCommand}" />
                <Button Content="Receive stock" Style="{StaticResource SuccessButton}" Command="{Binding ReceiveCommand}" />
                <Button Content="Print" Command="{Binding PrintCommand}" />
                <Button Content="Close / cancel" Command="{Binding CancelOrderCommand}" />
                <Button Content="Delete draft" Command="{Binding DeleteCommand}" Margin="0" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" Width="180" HorizontalAlignment="Left" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ORDER" Binding="{Binding OrderNumber}" Width="140" />
                    <DataGridTextColumn Header="SUPPLIER" Binding="{Binding Supplier.Name}" Width="*" />
                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="90" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status, Converter={StaticResource EnumDisplay}}" Width="120" />
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource RightCell}" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding Detail, Converter={StaticResource HasValueToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="17">
                            <Run Text="{Binding Detail.OrderNumber, Mode=OneWay}" /> · <Run Text="{Binding Detail.Supplier.Name, Mode=OneWay}" />
                        </TextBlock>
                        <WrapPanel>
                            <TextBlock Text="{Binding Detail.Status, Converter={StaticResource EnumDisplay}, StringFormat='Status: {0}'}" Margin="0,0,20,0" />
                            <TextBlock Text="{Binding Detail.ExpectedDate, StringFormat='Expected: {0:yyyy-MM-dd}'}" Margin="0,0,20,0" />
                            <TextBlock Text="{Binding Detail.ReceivedAt, StringFormat='Received: {0:yyyy-MM-dd}'}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Detail.Notes}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Right" FontSize="16" FontWeight="SemiBold">
                            <Run Text="{Binding Detail.TotalUnits, Mode=OneWay}" /> units ·
                            <Run Text="{Binding Detail.Total, Converter={StaticResource Money}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Detail.Lines}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding ProductVariant.DisplayName}" Width="*" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding ProductVariant.Sku}" Width="140" />
                            <DataGridTextColumn Header="ORDERED" Binding="{Binding QuantityOrdered}" Width="70" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="RECEIVED" Binding="{Binding QuantityReceived}" Width="80" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="COST" Binding="{Binding UnitCost, Converter={StaticResource Money}}" Width="80" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, Converter={StaticResource Money}}" Width="90" ElementStyle="{StaticResource RightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
