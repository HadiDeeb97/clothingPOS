<Application x:Class="ClothingStore.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClothingStore.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Views/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:MoneyConverter x:Key="Money" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="Not" />
            <conv:HasValueToVisibilityConverter x:Key="HasValueToVis" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:EnumDisplayConverter x:Key="EnumDisplay" />
            <conv:SignToBrushConverter x:Key="SignBrush" />
            <conv:InitialsConverter x:Key="Initials" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
